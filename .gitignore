# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local sqlite dev database
/prisma/*.db
/prisma/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills
# Third-party skill content, installed with `npx skills add`. Deliberately
# NOT committed: ~666KB of markdown this repo does not own or review,
# which would otherwise land in Batchline's history and its diffs. Only
# .claude/skills/ is ignored — .claude/launch.json IS tracked and must
# stay that way.
#
# skills-lock.json IS committed: it pins each skill's source and content
# hash, so `npx skills experimental_install` restores exactly these
# versions on another machine.
/.claude/skills/
/.commandcode/

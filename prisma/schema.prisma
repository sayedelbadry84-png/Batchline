// Batchline data model — Phase 1 (Foundation)
// Dev datasource is SQLite for zero-setup local running; swap provider to
// "postgresql" and DATABASE_URL to a Postgres connection string for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role is a plain string (SQLite has no native enum support); valid values
// are enforced in application code: ADMIN, PLANT_OPERATOR, QUALITY_SUPERVISOR,
// ACCOUNTANT, DRIVER, CUSTOMER.
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                String
  // ACTIVE, DISABLED — a disabled account fails login with the exact same
  // generic error as a wrong password or a lockout (see the note below),
  // so retiring the seeded demo accounts doesn't reveal which emails were
  // ever real. Deliberately not a delete: Session/AuditEvent rows still
  // reference the user.
  status              String    @default("ACTIVE")
  plantId             String?
  plant               Plant?    @relation(fields: [plantId], references: [id])
  // Links a DRIVER-role account to their Employee record, so the driver app
  // resolves "my trips" from the logged-in session instead of a picker.
  employeeId          String?   @unique
  employee            Employee? @relation(fields: [employeeId], references: [id])
  // Brute-force lockout: failedLoginAttempts resets to 0 on any successful
  // login; once it reaches the threshold in login.ts, lockedUntil is set a
  // fixed window into the future and every login attempt is rejected with
  // the same generic error as a wrong password, until that window passes —
  // deliberately not a distinct error, so a locked account isn't a way to
  // fingerprint which emails exist in the system.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // TOTP two-factor (RFC 6238), hand-rolled on Node's built-in crypto — no
  // external auth service, no SMS provider. totpSecret is the CONFIRMED
  // secret an authenticator app is actually using; totpTempSecret holds a
  // freshly-generated one during setup, only promoted to totpSecret once
  // the user proves they scanned/typed it correctly by submitting one
  // valid code — so 2FA can never end up "enabled" against a secret the
  // user never actually saved into their app.
  totpSecret          String?
  totpTempSecret      String?
  totpEnabled         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditEvents                 AuditEvent[]
  sessions                    Session[]
  reservationInitialApprovals Reservation[] @relation("ReservationInitialApproval")
  reservationFinalApprovals   Reservation[] @relation("ReservationFinalApproval")
  reservationClosures         Reservation[] @relation("ReservationClosedBy")
  apiKeysCreated              ApiKey[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// IP-level login throttle — a sibling to User.failedLoginAttempts, which
// only ever throttles ONE account at a time. Without this, an attacker
// spraying one guessed password across many different emails from the
// same source never trips any single account's lockout. No Redis: at this
// app's scale a plain indexed table query per attempt is trivial, and
// rows are pruned on the fly in login.ts rather than needing a cron job.
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// A physical factory location — a company runs several of these, and each
// one can house more than one production line (Plant). Deliberately
// lightweight: address/name/grouping only. Each Plant keeps its own
// currency/tax/geofence/tolerance settings rather than inheriting them
// from here, since those were already in daily use before multi-line
// sites existed and two lines at one site do sometimes run different
// batching tolerances in practice — a future request, not this one.
// What genuinely IS shared at the site level (raw-material silos/hoppers,
// via sharedAcrossPlants below) is scoped by siteId, not globally, so two
// unrelated sites' stock pools can never cross-contaminate each other.
// UI-terminology note: this model is displayed to users as "Plant" /
// "المصنع" (a physical factory location), and the Plant model below it is
// displayed as "Station" / "المحطة" (one production line inside that
// factory). The internal model/field names here (Site, Plant, siteId,
// plantId) were never renamed to match — only the label text was — since
// a full model rename is a far riskier migration for zero functional
// gain; every "site"/"plant" identifier in code still means exactly what
// it always did, it's only what the screen prints that changed.
model Site {
  id        String   @id @default(cuid())
  // Short, human-assigned business code ("S1", "CAI") — distinct from the
  // internal id, which nobody reads or types. What every other model's
  // "which site" filters and every report's site-scoping key off of
  // conceptually, even though the actual DB relation is still by id.
  code      String   @unique
  name      String
  city      String
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plants                Plant[]
  reservations          Reservation[]
  // Incentive policy/method lives at this level (Plant, in UI terms), not
  // the specific Station below — see the migration note on
  // DriverIncentivePolicy.
  incentivePolicies     DriverIncentivePolicy[]
  pumpIncentivePolicies PumpIncentivePolicy[]
  incentiveMethods      IncentiveMethod[]
}

model Plant {
  id                          String   @id @default(cuid())
  siteId                      String
  site                        Site     @relation(fields: [siteId], references: [id])
  // The production line's own label within its site ("Line 1", "خط 2") —
  // address/city/country live on Site above now, not duplicated here.
  name                        String
  // ACTIVE (normal), FROZEN (temporarily paused — new reservations/projects/
  // equipment/silos/material receipts against it are refused, but whatever
  // is already in flight or on file keeps working and stays visible), or
  // DECOMMISSIONED (the "delete a line" this app offers — same refusal as
  // FROZEN, just meant as permanent). Never a real row delete: too much
  // hangs off a Plant (silos, employees, trucks, batch tickets, invoices,
  // ...) for that to ever be safe — same convention as Employee/Truck/Pump.
  status                      String   @default("ACTIVE")
  currency                    String   @default("EGP")
  timezone                    String   @default("Africa/Cairo")
  // Applied to every invoice generated for this plant's projects, snapshotted
  // onto the invoice at generation time (see Invoice.taxRatePct) so a later
  // rate change never rewrites an already-issued invoice. taxLabel is the
  // name shown on the invoice ("VAT", "GST", "Sales Tax"...) since which
  // term applies depends on the plant's own jurisdiction, not the app.
  taxRatePct                  Float    @default(0)
  taxLabel                    String   @default("VAT")
  // Batching tolerance & alert configuration (Module 12 — Plant Management).
  drumTimerLimitMinutes       Int      @default(90)
  returnAbsorptionThresholdM3 Float    @default(0.2)
  // Preventive-maintenance threshold, shared by trucks and pumps (see
  // src/lib/maintenance.ts) — a single per-plant number is simpler to
  // reason about than a per-vehicle one, matching the batching-tolerance
  // fields above.
  maintenanceIntervalTrips    Int      @default(150)
  // Geofenced yard — "a mixer counts as home once it is inside this
  // circle" (from the RhinoMaster review). Purely informational: the
  // telematics webhook computes distance on each ping and the Equipment
  // map shows an "at yard" badge, but nothing here ever overwrites a
  // truck's manually-set status. All three null means geofencing is off
  // for this plant.
  yardLat                     Float?
  yardLng                     Float?
  yardRadiusM                 Float?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  users            User[]
  silos            Silo[]
  hoppers          Hopper[]
  employees        Employee[]
  invoices         Invoice[]
  trucks           Truck[]
  batchTickets     BatchTicket[]
  pumps            Pump[]
  materialReceipts MaterialReceipt[]
  pumpCrewMembers  PumpCrewMember[]
  supportVehicles  SupportVehicle[]
  chemicalTanks    ChemicalTank[]
}

model Silo {
  id                  String    @id @default(cuid())
  plantId             String
  plant               Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name                String
  materialType        String
  capacityTons        Float
  currentLevelTons    Float     @default(0)
  minThresholdPct     Float     @default(15)
  lastCalibration     DateTime?
  // Populated by the SCADA sensor-reading webhook (see /api/scada/silo-reading)
  // to distinguish a sensor-fed level from a manual dashboard override.
  lastSensorReadingAt DateTime?
  // A cement/fly-ash tank feeding more than one production line at the
  // same site — plantId above is still the "home" line, but
  // completeBatch's consumption lookup (production/actions.ts) matches a
  // shared silo for ANY line's ticket at the SAME site, not just its own,
  // once this is true. Mirrors Hopper.sharedAcrossPlants below.
  sharedAcrossPlants  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  receipts MaterialReceipt[]
}

model Hopper {
  id                 String   @id @default(cuid())
  plantId            String
  plant              Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name               String
  aggregateType      String
  capacityTons       Float
  currentLevelTons   Float    @default(0)
  // A yard heap multiple production lines at the same site draw from —
  // plantId above is still the "home"/organizational line, but
  // completeBatch's consumption lookup (production/actions.ts) matches a
  // shared hopper for any OTHER line's ticket at the SAME site (never a
  // different site), not just its own, once this is true.
  sharedAcrossPlants Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  receipts MaterialReceipt[]
}

// Liquid admixture inventory — separate from Silo/Hopper because it's
// tracked in liters, not tons, and a plant typically has one tank per
// specific admixture product rather than per material-type category.
// Wired into completeBatch's deduction loop the same way silos/hoppers
// are, converting a component's batched mass back to liters via the
// material's specific gravity (the inverse of the kg conversion
// addComponent already does when a mix recipe is entered in liters).
model ChemicalTank {
  id                 String   @id @default(cuid())
  plantId            String
  plant              Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material @relation(fields: [materialId], references: [id])
  name               String
  capacityLiters     Float?
  currentLevelLiters Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([plantId, materialId])
}

model MixDesign {
  id            String   @id @default(cuid())
  code          String   @unique
  grade         String
  exposureClass String?
  slumpTargetMm Float
  wcRatio       Float
  yieldTargetM3 Float    @default(1)
  status        String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, RETIRED
  standardCost  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  components       MixComponent[]
  reservations     Reservation[]
  batchTickets     BatchTicket[]
  certificates     ComplianceCertificate[]
  priceListEntries PriceListEntry[]
}

model Material {
  id              String    @id @default(cuid())
  name            String
  type            String // CEMENT, FLY_ASH, SAND, COARSE_AGGREGATE, ADMIXTURE, WATER
  brand           String?
  specificGravity Float?
  absorptionPct   Float?
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mixComponents MixComponent[]
  batchActuals  BatchComponentActual[]
  receipts      MaterialReceipt[]
  chemicalTanks ChemicalTank[]
}

model MixComponent {
  id                String    @id @default(cuid())
  mixId             String
  mix               MixDesign @relation(fields: [mixId], references: [id], onDelete: Cascade)
  materialId        String
  material          Material  @relation(fields: [materialId], references: [id])
  designMassKgPerM3 Float
  tolerancePct      Float     @default(2)
  // Display-only — the mass figure above stays the single source of truth
  // for every yield/tolerance calculation. Chemical admixtures are
  // conventionally dosed by volume on site; when set to LITER the
  // component table shows designMassKgPerM3 / material.specificGravity
  // instead of kg, without a second stored quantity to keep in sync.
  dosageUnit        String    @default("KG") // KG, LITER

  @@unique([mixId, materialId])
}

model Customer {
  id           String   @id @default(cuid())
  // Company-wide customer identifier — auto-generated as "C-00001" style
  // on create if left blank, or set by hand. Nullable/unique rather than
  // required so existing rows never need a forced backfill.
  code         String?  @unique
  legalName    String
  taxId        String?
  creditLimit  Float    @default(0)
  paymentTerms String   @default("Net 30")
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects         Project[]
  priceListEntries PriceListEntry[]
  invoices         Invoice[]
}

model Supplier {
  id               String   @id @default(cuid())
  name             String
  materialCatalog  String?
  leadTimeDays     Int?
  rejectionRatePct Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  materials        Material[]
  materialReceipts MaterialReceipt[]
}

// A customer's job site — company-wide, not tied to any one plant/line.
// Which plant actually produces for it is decided per Reservation (a big
// job site can be poured from whichever nearby line has capacity that
// day), not fixed at the project level.
model Project {
  id                 String   @id @default(cuid())
  name               String
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  siteAddress        String
  contractedVolumeM3 Float?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reservations Reservation[]
  invoices     Invoice[]
}

model Reservation {
  id                    String    @id @default(cuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id])
  // Which factory (Site — see the UI-terminology note on that model) this
  // reservation is booked against. Deliberately NOT a specific production
  // line: at booking time only the factory is committed to, since the
  // customer/office side doesn't care and shouldn't have to care which of
  // that factory's stations actually produces it. The specific line is
  // chosen later, at batch-ticket release time (see BatchTicket.plantId
  // in Production) — that's the operational decision, made when it's
  // actually known which station has capacity right now.
  siteId                String
  site                  Site      @relation(fields: [siteId], references: [id])
  mixId                 String
  mix                   MixDesign @relation(fields: [mixId], references: [id])
  requestedVolumeM3     Float
  // Snapshotted once at creation and never touched again by
  // updateReservation — requestedVolumeM3 above is the current (possibly
  // revised) figure, this is what was actually booked first, so a report
  // can show "booked 21, now 39" instead of losing the revision history
  // (from the Dynamics Job Qty / Net Qty comparison). Null on rows created
  // before this field existed; treat null as "same as requestedVolumeM3."
  originalVolumeM3      Float?
  pourWindowStart       DateTime
  status                String    @default("REQUESTED") // REQUESTED, CONFIRMED, IN_PRODUCTION, DELIVERED, CANCELLED
  // Pour-order details captured at intake — distinct from the mix design's
  // own slump target, since site conditions can call for an adjustment on
  // the day (e.g. a pump mix run wetter than the design slump).
  slumpRequestedMm      Float?
  // How far the measured slump may miss slumpRequestedMm and still pass —
  // separate from the fixed SLUMP_TOLERANCE_MM the Reports module uses as
  // a plant-wide default, since a specific pour can call for a tighter or
  // looser band. Null means "use the plant-wide default."
  slumpToleranceMm      Float?
  // Printed on the delivery ticket when the job specifies one — OPC or
  // SRC. Null means the job didn't ask, not "OPC by default": leaving it
  // unset is a real, distinct state from choosing OPC.
  cementType            String?
  // Maximum concrete temperature allowed at discharge — a real rejection
  // threshold checked against TestBatch.concreteTempC when a sample is
  // logged (see Quality), not just an informational number on the ticket.
  temperatureC          Float?
  siteLocation          String?
  // A pasted maps share link, sent straight to the driver — simpler and
  // more directly actionable on site than structured lat/lng would be.
  siteLocationUrl       String?
  siteContactName       String?
  siteContactPhone      String?
  deliveryMethod        String?   @default("CHUTE") // PUMP, CHUTE
  // Free-text specific label ("Column C12", "Slab L3") — distinct from
  // structureType below, which is the fixed category used for reporting.
  structuralElement     String?
  // FOUNDATION, SLAB, COLUMN, COLUMN_NECK, BEAM, ROOF, RAFT, OTHER — a fixed
  // list (from the RhinoMaster/Dynamics comparison) so "how much concrete
  // went into columns this month" is a real query, not a free-text guess.
  structureType         String?
  // Required boom/line reach for a pump delivery — checked against
  // Pump.reachM when assigning a pump on the trip-start form (see
  // production/[id]/page.tsx), the same kind of real validation threshold
  // temperatureC already is for concrete temperature.
  minPumpReachM         Float?
  labTechnicianRequired Boolean   @default(false)
  // Two-stage sign-off gate a reservation must clear before Production will
  // release a batch ticket against it — distinct from `status` above, which
  // tracks the delivery lifecycle rather than who signed off. Initial is
  // the reservations officer confirming the booking itself is sound; final
  // is operations management clearing it to actually be produced. Both
  // null means "not yet activated," same meaning whether the reservation
  // was just created or was edited enough to warrant re-approval.
  initialApprovedAt     DateTime?
  initialApprovedById   String?
  initialApprovedBy     User?     @relation("ReservationInitialApproval", fields: [initialApprovedById], references: [id])
  finalApprovedAt       DateTime?
  finalApprovedById     String?
  finalApprovedBy       User?     @relation("ReservationFinalApproval", fields: [finalApprovedById], references: [id])
  // Set only by closeReservation (the "end this reservation now" action) —
  // a structured reason (from the Dynamics ModCancelReason comparison,
  // same style as DrumReturn.reasonCode) plus an optional free-text note,
  // so closing early is an accountable action, not a silent status flip.
  closedAt              DateTime?
  closedById            String?
  closedBy              User?     @relation("ReservationClosedBy", fields: [closedById], references: [id])
  closeReasonCode       String?
  closeNote             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  batchTickets    BatchTicket[]
  pumpAssignments PumpAssignment[]
}

model Employee {
  id            String    @id @default(cuid())
  plantId       String
  plant         Plant     @relation(fields: [plantId], references: [id])
  name          String
  role          String
  // Per-employee identifier (badge/payroll number) — distinct from `role`,
  // which is the job title. Optional and unique when set; Postgres allows
  // any number of NULLs under a unique constraint, so employees without a
  // code on file never collide.
  code          String?   @unique
  licenseNumber String?
  licenseExpiry DateTime?
  shiftPattern  String?
  // ACTIVE, FROZEN (temporarily suspended, kept on file), REMOVED (soft
  // delete — never a real row delete, same reasoning as User.status: the
  // employee's trip/receipt history must keep resolving to a real name).
  // "Transfer to another plant" is just editing plantId above, not a
  // separate status value.
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  trips                     Trip[]
  sampledTestBatches        TestBatch[]
  materialReceiptsDriven    MaterialReceipt[]
  defaultForTrucks          Truck[]
  defaultForSupportVehicles SupportVehicle[]
  user                      User?
}

// Admin-managed job-title catalog — supplements the hardcoded role list on
// the Employees "admin" tab (office/support roles) so a new position can be
// added from the screen itself instead of a code change. Org-wide, not
// per-plant: a job title like "Batching Technician" isn't specific to one
// site. Employee.role stays a plain string either way (see the comment on
// that field) — this table just feeds the picker with more options over
// time.
model JobTitle {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Material Receiving
// ---------------------------------------------------------------------------

model MaterialReceipt {
  id                  String    @id @default(cuid())
  plantId             String
  plant               Plant     @relation(fields: [plantId], references: [id])
  supplierId          String
  supplier            Supplier  @relation(fields: [supplierId], references: [id])
  materialId          String
  material            Material  @relation(fields: [materialId], references: [id])
  poNumber            String?
  orderedMassKg       Float?
  grossWeightKg       Float
  tareWeightKg        Float
  netWeightKg         Float
  moisturePct         Float?
  qcStatus            String    @default("PENDING") // PENDING, PASSED, HELD, REJECTED
  postedToInventory   Boolean   @default(false)
  destinationSiloId   String?
  destinationSilo     Silo?     @relation(fields: [destinationSiloId], references: [id])
  destinationHopperId String?
  destinationHopper   Hopper?   @relation(fields: [destinationHopperId], references: [id])
  // Who physically drove this delivery — a cement bulker for a CEMENT
  // receipt, a water tanker for a WATER one. Optional and free-text-
  // capable like Trip's pump-crew fields: pick from the roster (an
  // Employee with role BULKER_DRIVER/WATER_TANKER_DRIVER) when possible,
  // but a delivery can still be logged with just a typed name. Feeds the
  // per-role incentive tables on the Incentives page (src/lib/incentives.ts).
  driverId            String?
  driver              Employee? @relation(fields: [driverId], references: [id])
  driverName          String?
  receivedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 2 — Production & Fleet
// ---------------------------------------------------------------------------

model Truck {
  id                String    @id @default(cuid())
  plantId           String
  plant             Plant     @relation(fields: [plantId], references: [id])
  code              String
  drumCapacityM3    Float
  maxAgitationRpm   Float?
  gpsDeviceId       String?
  // Registration details — optional since older/imported records may not
  // have them on file yet; nothing downstream depends on these being set.
  year              Int?
  chassisNumber     String?
  plateNumber       String?
  // Pre-fills the driver field when this truck is picked to start a trip
  // (see startTrip/updateTripAssignment) — still just a default, not a
  // lock: the operator can always pick someone else for that specific trip.
  defaultDriverId   String?
  defaultDriver     Employee? @relation(fields: [defaultDriverId], references: [id])
  status            String    @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE, OUT_OF_SERVICE
  // Populated by the GPS telematics webhook (see /api/telematics/ping).
  lastLat           Float?
  lastLng           Float?
  lastPingAt        DateTime?
  // Reset by the "mark serviced" action — trips since this date (via
  // Trip.batchTime) feed the due-for-inspection flag in
  // src/lib/maintenance.ts. Null means "never recorded," which counts
  // every trip ever as "since last maintenance."
  lastMaintenanceAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trips Trip[]
}

// A batch ticket is released against a confirmed reservation. Component
// targets are snapshotted from the mix design at release time (scaled to
// the requested volume) so a later mix-design edit never silently changes
// a ticket that has already been batched.
model BatchTicket {
  id               String      @id @default(cuid())
  reservationId    String
  reservation      Reservation @relation(fields: [reservationId], references: [id])
  mixId            String
  mix              MixDesign   @relation(fields: [mixId], references: [id])
  plantId          String
  plant            Plant       @relation(fields: [plantId], references: [id])
  ticketNumber     String      @unique
  volumeM3         Float
  status           String      @default("RELEASED") // RELEASED, BATCHING, COMPLETE, CANCELLED
  releasedAt       DateTime    @default(now())
  batchCompletedAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  components BatchComponentActual[]
  trip       Trip?
}

model BatchComponentActual {
  id            String      @id @default(cuid())
  batchTicketId String
  batchTicket   BatchTicket @relation(fields: [batchTicketId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material    @relation(fields: [materialId], references: [id])
  targetMassKg  Float
  actualMassKg  Float?
  moisturePct   Float?

  @@unique([batchTicketId, materialId])
}

model Trip {
  id                   String          @id @default(cuid())
  batchTicketId        String          @unique
  batchTicket          BatchTicket     @relation(fields: [batchTicketId], references: [id])
  truckId              String
  truck                Truck           @relation(fields: [truckId], references: [id])
  driverId             String
  driver               Employee        @relation(fields: [driverId], references: [id])
  // Only set when the reservation's delivery method is PUMP — the specific
  // pump unit and crew placing this load, as distinct from the pump
  // booking calendar (PumpAssignment), which schedules a pump against a
  // reservation for billing hours rather than recording who ran it.
  pumpId               String?
  pump                 Pump?           @relation(fields: [pumpId], references: [id])
  // Free-text name is still the field every read path renders — picking a
  // crew member below just fills it from PumpCrewMember.name at write time
  // (see startTrip), so a trip can still name someone off-roster without
  // forcing every operator into master data on day one.
  pumpOperatorName     String?
  pumpAssistantName    String?
  pumpOperatorId       String?
  pumpOperatorCrew     PumpCrewMember? @relation("PumpOperatorCrew", fields: [pumpOperatorId], references: [id])
  pumpAssistantId      String?
  pumpAssistantCrew    PumpCrewMember? @relation("PumpAssistantCrew", fields: [pumpAssistantId], references: [id])
  status               String          @default("LOADING") // LOADING, IN_TRANSIT, ON_SITE, DISCHARGING, CLOSED
  batchTime            DateTime        @default(now())
  departTime           DateTime?
  arriveTime           DateTime?
  dischargeStart       DateTime?
  dischargeEnd         DateTime?
  volumeDeliveredM3    Float?
  // Driver-app delivery confirmation. The photo is stored as a data URL for
  // this phase (no object storage wired up yet) — fine for demo volumes,
  // swap for a real blob store (S3-compatible) before production traffic.
  deliveryPhotoDataUrl String?
  deliverySignedBy     String?
  deliverySignedAt     DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  drumReturn  DrumReturn?
  testBatches TestBatch[]
  invoiceLine InvoiceLine?
}

model DrumReturn {
  id                String   @id @default(cuid())
  tripId            String   @unique
  trip              Trip     @relation(fields: [tripId], references: [id])
  returnedVolumeM3  Float
  minutesSinceBatch Int
  disposition       String // NO_CHARGE, REDISPATCHED, PARTIAL_CREDIT, FULL_WASTE
  // Why the load came back — orthogonal to disposition, which is the
  // time/volume-driven financial outcome. Unrecorded until now (from the
  // RhinoMaster/Dynamics return-ticket comparison): CUSTOMER_CANCELLED,
  // SITE_NOT_READY, OVER_ORDERED, ACCESS_BLOCKED, QUALITY_REJECTED,
  // TRAFFIC_DELAY, OTHER.
  reasonCode        String?
  // What physically happened to the returned concrete — DUMPED or
  // RECLAIMED (fed into a reclaimer / reused in another batch). Also
  // unrecorded until now; independent of disposition and reasonCode.
  fate              String?
  note              String?
  createdAt         DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 3 — Quality & Compliance
// ---------------------------------------------------------------------------

model TestBatch {
  id              String    @id @default(cuid())
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id])
  sampleType      String    @default("CYLINDER") // CYLINDER, CUBE, SLUMP_ONLY
  sampleTime      DateTime  @default(now())
  slumpMeasuredMm Float?
  airContentPct   Float?
  concreteTempC   Float?
  sampledById     String?
  sampledBy       Employee? @relation(fields: [sampledById], references: [id])
  createdAt       DateTime  @default(now())

  labResults LabResult[]
}

model LabResult {
  id                String    @id @default(cuid())
  testBatchId       String
  testBatch         TestBatch @relation(fields: [testBatchId], references: [id], onDelete: Cascade)
  ageDays           Int
  breakStrengthMpa  Float
  targetStrengthMpa Float
  passFail          String // PASS, FAIL
  testedOn          DateTime  @default(now())
  createdAt         DateTime  @default(now())
}

model ComplianceCertificate {
  id          String    @id @default(cuid())
  mixId       String
  mix         MixDesign @relation(fields: [mixId], references: [id])
  standardRef String
  issuedDate  DateTime
  expiryDate  DateTime
  issuingBody String
  documentUrl String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Pumps
// ---------------------------------------------------------------------------

model Pump {
  id                 String          @id @default(cuid())
  plantId            String
  plant              Plant           @relation(fields: [plantId], references: [id])
  code               String
  pumpType           String // BOOM, LINE, STATIONARY
  reachM             Float?
  hourlyRate         Float
  standbyRate        Float?
  // Registration details, same optional/informational role as on Truck.
  year               Int?
  chassisNumber      String?
  plateNumber        String?
  // Pre-fill the operator/assistant fields when this pump is picked to
  // start a pump-delivery trip — still just defaults, always overridable
  // for that specific trip (see startTrip/updateTripAssignment).
  defaultOperatorId  String?
  defaultOperator    PumpCrewMember? @relation("PumpDefaultOperator", fields: [defaultOperatorId], references: [id])
  defaultAssistantId String?
  defaultAssistant   PumpCrewMember? @relation("PumpDefaultAssistant", fields: [defaultAssistantId], references: [id])
  status             String          @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE, OUT_OF_SERVICE
  // Same due-for-inspection mechanism as Truck.lastMaintenanceAt.
  lastMaintenanceAt  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignments PumpAssignment[]
  trips       Trip[]
}

// Not @unique on reservationId — a large pour can need more than one pump
// working simultaneously, so a reservation may carry several assignments.
model PumpAssignment {
  id             String      @id @default(cuid())
  pumpId         String
  pump           Pump        @relation(fields: [pumpId], references: [id])
  reservationId  String
  reservation    Reservation @relation(fields: [reservationId], references: [id])
  scheduledStart DateTime
  billedHours    Float?
  status         String      @default("SCHEDULED") // SCHEDULED, ON_SITE, COMPLETE, CANCELLED
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 6 — Billing (pricing, invoicing, AR)
// ---------------------------------------------------------------------------

model PriceListEntry {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mixId      String
  mix        MixDesign @relation(fields: [mixId], references: [id])
  pricePerM3 Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([customerId, mixId])
}

// One invoice per generation run against a project's not-yet-invoiced closed
// trips — see generateInvoiceForProject. Status is a simple linear flow
// (DRAFT -> SENT -> PAID, or CANCELLED); "overdue" is deliberately NOT a
// stored status — it's derived at display time from dueDate + payments, the
// same pattern the app already uses for certificate expiry, so there's no
// background job to keep it in sync.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  // Which line the invoiced trips were actually produced at — a project
  // itself carries no plant (see the Project model comment), so this is
  // snapshotted from the trips' own reservation.plantId at generation
  // time. Nullable for the same reason projectId is: an invoice with no
  // project can't resolve one either. One invoice never mixes trips from
  // more than one plant (see generateInvoiceForProject) specifically so
  // this field — and the tax rate below — always means one real thing.
  plantId       String?
  plant         Plant?   @relation(fields: [plantId], references: [id])
  status        String   @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  issueDate     DateTime @default(now())
  dueDate       DateTime
  subtotal      Float
  // Snapshotted from Plant.taxRatePct/taxLabel at generation time — the
  // plant's rate can change later without altering an already-issued
  // invoice's own numbers.
  taxRatePct    Float    @default(0)
  taxLabel      String   @default("VAT")
  taxAmount     Float    @default(0)
  total         Float
  currency      String   @default("EGP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]
}

// One line per delivered trip — the delivery ticket is the natural billing
// unit in ready-mix, not the reservation (a split reservation bills as
// several lines, possibly across several invoices).
model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tripId      String  @unique
  trip        Trip    @relation(fields: [tripId], references: [id])
  description String
  volumeM3    Float
  unitPrice   Float
  lineTotal   Float
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime @default(now())
  method    String? // CASH, BANK_TRANSFER, CHEQUE
  reference String?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Fleet — pump crew roster & driver incentives (from the RhinoMaster review)
// ---------------------------------------------------------------------------

// A reusable roster, distinct from the free-text pumpOperatorName/
// pumpAssistantName already on Trip — picking a name here instead of typing
// one prevents typos and lets an operator's history be tracked across many
// pump jobs over time.
model PumpCrewMember {
  id        String   @id @default(cuid())
  plantId   String
  plant     Plant    @relation(fields: [plantId], references: [id])
  name      String
  role      String // OPERATOR, HELPER
  phone     String?
  // Same per-person identifier as Employee.code — lets a company-wide
  // report (see getWorkerProductivityReport) recognize the same crew
  // member across more than one site-specific registration, since a
  // PumpCrewMember row (like Employee) belongs to exactly one plant.
  code      String?  @unique
  // ACTIVE, FROZEN, REMOVED — same three-state convention as
  // Employee.status (INACTIVE is kept as a legacy synonym of FROZEN on
  // existing rows rather than migrated, since it's just a display label).
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operatorTrips              Trip[] @relation("PumpOperatorCrew")
  assistantTrips             Trip[] @relation("PumpAssistantCrew")
  defaultForPumpsAsOperator  Pump[] @relation("PumpDefaultOperator")
  defaultForPumpsAsAssistant Pump[] @relation("PumpDefaultAssistant")
}

// A tiered per-trip bonus, one policy per plant — trips 1..freeTripsThreshold
// earn nothing, each trip up to tier2Threshold earns tier2RateSar, each up
// to tier3Threshold earns tier3RateSar, and every trip beyond that earns
// beyondRateSar. Payout itself is never stored — it's computed live from
// closed Trip counts per driver (src/lib/incentives.ts), the same
// derive-from-what-already-exists approach as the anomaly/strength/demand
// features above. Rates are in the plant's own currency, not a separate one.
// One policy per (plant, role) — generalized from a single driver-only
// policy per plant so pump crew and material-delivery drivers can each
// have their own tier ladder, not just mixer drivers. Model name kept as
// DriverIncentivePolicy (not renamed to something role-neutral) purely to
// avoid Prisma treating a model rename as drop-and-recreate against a
// live database with real rows — role below is what actually generalizes
// it. role is a plain string rather than every role in the system, since
// only roles with a real trip-count source (see src/lib/incentives.ts and
// the Incentives page) ever get a policy: MIXER_DRIVER, PUMP_OPERATOR,
// PUMP_ASSISTANT, BULKER_DRIVER, WATER_TANKER_DRIVER.
model DriverIncentivePolicy {
  id                 String   @id @default(cuid())
  // Which factory (Site — see the UI-terminology note on that model) this
  // policy applies to. Deliberately Plant-level, not a specific Station:
  // a driver can load from more than one station at the same plant (or
  // even a different plant) in one day, so the rate/threshold that
  // applies is whichever plant a given trip actually happened at, not a
  // station the driver happens to be nominally assigned to.
  siteId             String
  site               Site     @relation(fields: [siteId], references: [id])
  role               String   @default("MIXER_DRIVER")
  freeTripsThreshold Int      @default(10)
  tier2Threshold     Int      @default(15)
  // Field names carry "Sar" from the reviewed system's own SAR-denominated
  // policy — the actual amount is always rendered in the owning plant's
  // own currency (Plant.currency), never a second stored currency.
  tier2RateSar       Float    @default(0)
  tier3Threshold     Int      @default(20)
  tier3RateSar       Float    @default(0)
  beyondRateSar      Float    @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([siteId, role])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  role        String
  module      String
  recordId    String
  field       String?
  beforeValue String?
  afterValue  String?
  reasonCode  String?
  createdAt   DateTime @default(now())
}

// Database-editable override of the compiled-in MODULE_ROLES map
// (src/lib/permissions.ts) — lets an Admin grant/revoke a role's access to
// a module from the Permissions screen instead of it only ever being a
// code change. A module with zero rows here still works: canAccessModule
// falls back to its MODULE_ROLES default, so this table starts empty and
// only ever holds the modules an Admin has actually touched. Deliberately
// role-only (no plantId) — permissions are which screens a role can reach
// at all, not a per-plant concern, same scope MODULE_ROLES already had.
model RolePermission {
  id        String   @id @default(cuid())
  moduleKey String
  role      String
  createdAt DateTime @default(now())

  @@unique([moduleKey, role])
}

// Finer-grained sibling of RolePermission — gates one specific action
// within a module (e.g. "approve a reservation" vs. just "view
// reservations") rather than the whole screen. Same fallback shape: the
// compiled default for each actionKey lives in ACTION_ROLES
// (src/lib/permissions.ts); a module/action pair with zero rows here
// falls back to that default until an Admin actually customizes it.
model ActionPermission {
  id        String   @id @default(cuid())
  moduleKey String
  actionKey String
  role      String
  createdAt DateTime @default(now())

  @@unique([moduleKey, actionKey, role])
}

// Volume-based incentive policy — despite the name (kept from when this
// only covered pump operators, and left as-is to avoid Prisma treating a
// rename as drop-and-recreate against a live database), this now backs
// ANY role whose incentive method is VOLUME_M3 (see IncentiveMethod
// below), not just PUMP_OPERATOR. Priced per m³ by a rate bracket:
// PUMP_OPERATOR/PUMP_ASSISTANT get real reach-tiered brackets (a
// longer-reach pump job prices differently than a short one, from the
// same Trip/Pump); every other volume-based role just gets a single
// "flat" bracket (minReachM 0, maxReachM null) since reach doesn't apply
// to them — calculateVolumeIncentivePayout in src/lib/incentives.ts
// matches that catch-all bracket even when a trip has no reachM at all.
// One policy per (plant, role); its rate table is PumpReachRateBracket.
model PumpIncentivePolicy {
  id           String   @id @default(cuid())
  // Plant-level, not Station-level — same reasoning as
  // DriverIncentivePolicy.siteId above: a pump crew can work more than
  // one station (even more than one plant) in a day.
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  role         String   @default("PUMP_OPERATOR")
  // "تارجت الشركة" — company target: m³ (or, for BULKER/WATER_TANKER
  // roles, tons) delivered up to this amount in the period earns
  // nothing; only the amount beyond it is priced, and only at the rate
  // bracket matching whichever pump actually carried it (pump roles) or
  // the plant's single flat rate (every other role).
  freeVolumeM3 Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rateBrackets PumpReachRateBracket[]

  @@unique([siteId, role])
}

model PumpReachRateBracket {
  id           String              @id @default(cuid())
  policyId     String
  policy       PumpIncentivePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  minReachM    Float
  // null = open-ended top bracket ("60m and up").
  maxReachM    Float?
  ratePerM3Sar Float
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// Which of the two incentive calculations applies to a (plant, role) pair
// — TRIP_COUNT (tiered per-trip bonus, DriverIncentivePolicy) or VOLUME_M3
// (per-m³ commission above a target, PumpIncentivePolicy). Same
// fallback-to-compiled-default shape as RolePermission/ActionPermission in
// src/lib/permissions.ts: a role with zero rows here uses the compiled
// DEFAULT_INCENTIVE_METHOD map (src/lib/incentives.ts) until an Admin
// picks explicitly from the Incentives module's "plan" tab.
model IncentiveMethod {
  id        String   @id @default(cuid())
  // Plant-level, not Station-level — same reasoning as
  // DriverIncentivePolicy.siteId above.
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  role      String
  method    String // TRIP_COUNT, VOLUME_M3
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, role])
}

// Cement bulkers, water tankers, and loaders share one model (rather than
// three near-identical ones like Truck/Pump) since none of them carry the
// type-specific spec fields those two do (drum capacity, pump reach) — just
// registration details and a default driver. `type` is what the Equipment
// screen's tabs filter on.
model SupportVehicle {
  id              String    @id @default(cuid())
  plantId         String
  plant           Plant     @relation(fields: [plantId], references: [id])
  type            String // BULKER, WATER_TANKER, LOADER
  code            String
  year            Int?
  chassisNumber   String?
  plateNumber     String?
  defaultDriverId String?
  defaultDriver   Employee? @relation(fields: [defaultDriverId], references: [id])
  status          String    @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE, OUT_OF_SERVICE
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// A revocable, scoped credential for a machine-to-machine caller (a GPS
// telematics provider, a SCADA edge gateway) — replaces relying on one
// shared INTEGRATION_API_KEY env var for every integration forever. Only
// the SHA-256 hash is stored (src/lib/apiKeys.ts), never the raw key —
// it's shown to the Admin exactly once at creation time and can't be
// recovered afterward, only revoked and replaced with a new one. scope
// limits what a compromised or over-shared key can actually do (a GPS
// provider's key has no business posting silo readings). The legacy env
// var still works as an ALL-scope fallback for compatibility —
// verifyIntegrationRequest in src/lib/integration-auth.ts checks both.
model ApiKey {
  id          String    @id @default(cuid())
  label       String
  keyHash     String    @unique
  // First few characters of the raw key, kept in the clear so the Admin
  // can recognize which key is which in the list without the full secret.
  keyPrefix   String
  scope       String    @default("ALL") // ALL, TELEMATICS, SCADA
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

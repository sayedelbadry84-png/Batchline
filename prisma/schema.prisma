// Batchline data model — Phase 1 (Foundation)
// Dev datasource is SQLite for zero-setup local running; swap provider to
// "postgresql" and DATABASE_URL to a Postgres connection string for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled at runtime (see .env's own comment — Neon's PgBouncer endpoint,
  // needed so concurrent serverless/script connections don't exhaust the
  // direct endpoint's much lower connection cap); directUrl is the
  // unpooled endpoint the Prisma CLI itself uses for `db push`/migrate,
  // which need a real session-mode connection.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Role is a plain string (SQLite has no native enum support); valid values
// are enforced in application code: ADMIN, PLANT_OPERATOR, QUALITY_SUPERVISOR,
// ACCOUNTANT, DRIVER, CUSTOMER.
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  role                String
  // ACTIVE, DISABLED — a disabled account fails login with the exact same
  // generic error as a wrong password or a lockout (see the note below),
  // so retiring the seeded demo accounts doesn't reveal which emails were
  // ever real. Deliberately not a delete: Session/AuditEvent rows still
  // reference the user.
  status              String    @default("ACTIVE")
  plantId             String?
  plant               Plant?    @relation(fields: [plantId], references: [id])
  // Links a DRIVER-role account to their Employee record, so the driver app
  // resolves "my trips" from the logged-in session instead of a picker.
  employeeId          String?           @unique
  employee            Employee?         @relation(fields: [employeeId], references: [id])
  // Same idea as employeeId above, but for a PUMP_OPERATOR-role account —
  // PumpCrewMember is a separate roster from Employee (see that model's
  // own comment), so it needs its own link rather than reusing employeeId.
  pumpCrewMemberId    String?           @unique
  pumpCrewMember      PumpCrewMember?   @relation(fields: [pumpCrewMemberId], references: [id])
  // Brute-force lockout: failedLoginAttempts resets to 0 on any successful
  // login; once it reaches the threshold in login.ts, lockedUntil is set a
  // fixed window into the future and every login attempt is rejected with
  // the same generic error as a wrong password, until that window passes —
  // deliberately not a distinct error, so a locked account isn't a way to
  // fingerprint which emails exist in the system.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // TOTP two-factor (RFC 6238), hand-rolled on Node's built-in crypto — no
  // external auth service, no SMS provider. totpSecret is the CONFIRMED
  // secret an authenticator app is actually using; totpTempSecret holds a
  // freshly-generated one during setup, only promoted to totpSecret once
  // the user proves they scanned/typed it correctly by submitting one
  // valid code — so 2FA can never end up "enabled" against a secret the
  // user never actually saved into their app.
  totpSecret          String?
  totpTempSecret      String?
  totpEnabled         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditEvents                      AuditEvent[]
  sessions                         Session[]
  reservationInitialApprovals      Reservation[]             @relation("ReservationInitialApproval")
  reservationFinalApprovals        Reservation[]             @relation("ReservationFinalApproval")
  reservationClosures              Reservation[]             @relation("ReservationClosedBy")
  apiKeysCreated                   ApiKey[]
  wasteMemoApprovals               WasteIncidentMemo[]       @relation("WasteMemoApproval")
  salesOpportunitiesOwned          Opportunity[]             @relation("OpportunityOwner")
  fieldVisitsLogged                FieldVisit[]              @relation("FieldVisitVisitedBy")
  quotesPrepared                   Quote[]                   @relation("QuotePreparedBy")
  purchaseOrdersCreated            PurchaseOrder[]           @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved            PurchaseOrder[]           @relation("PurchaseOrderApprovedBy")
  maintenanceTicketsReported       MaintenanceTicket[]       @relation("MaintenanceReportedBy")
  maintenanceTicketsAssigned       MaintenanceTicket[]       @relation("MaintenanceAssignedTo")
  cashTransactionsCreated          CashTransaction[]         @relation("CashTransactionCreatedBy")
  opportunityInitialApprovals      Opportunity[]             @relation("OpportunityInitialApproval")
  opportunityFinalApprovals        Opportunity[]             @relation("OpportunityFinalApproval")
  fieldVisitInitialApprovals       FieldVisit[]              @relation("FieldVisitInitialApproval")
  fieldVisitFinalApprovals         FieldVisit[]              @relation("FieldVisitFinalApproval")
  quoteInitialApprovals            Quote[]                   @relation("QuoteInitialApproval")
  quoteFinalApprovals              Quote[]                   @relation("QuoteFinalApproval")
  attendanceRecordsRecorded        AttendanceRecord[]        @relation("AttendanceRecordedBy")
  leaveRequestsRequested           LeaveRequest[]            @relation("LeaveRequestedBy")
  leaveRequestsApproved            LeaveRequest[]            @relation("LeaveApprovedBy")
  maintenanceOrdersCreated         MaintenanceOrder[]
  maintenanceOrderPartsIssued      MaintenanceOrderPart[]
  sparePartReceiptsReceived        SparePartReceipt[]
  sparePartsRequisitionsRequested  SparePartsRequisition[]   @relation("SPRRequestedBy")
  sparePartsRequisitionsApproved   SparePartsRequisition[]   @relation("SPRApprovedBy")
  materialRequisitionsRequested    MaterialRequisition[]     @relation("MTRRequestedBy")
  materialRequisitionsApproved     MaterialRequisition[]     @relation("MTRApprovedBy")
  capaResponsibleFor               CapaRecord[]               @relation("CapaResponsible")
  capaClosed                       CapaRecord[]               @relation("CapaClosedBy")
  finishedProductMovementsRecorded FinishedProductMovement[]
  creditNotesIssued                CreditNote[]
  payrollRunsCreated               PayrollRun[]               @relation("PayrollRunCreatedBy")
  payrollRunsApproved              PayrollRun[]               @relation("PayrollRunApprovedBy")
  notifications                    Notification[]
  pushSubscriptions                PushSubscription[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// IP-level login throttle — a sibling to User.failedLoginAttempts, which
// only ever throttles ONE account at a time. Without this, an attacker
// spraying one guessed password across many different emails from the
// same source never trips any single account's lockout. No Redis: at this
// app's scale a plain indexed table query per attempt is trivial, and
// rows are pruned on the fly in login.ts rather than needing a cron job.
model LoginAttempt {
  id        String   @id @default(cuid())
  ipAddress String
  createdAt DateTime @default(now())

  @@index([ipAddress, createdAt])
}

// A physical factory location — a company runs several of these, and each
// one can house more than one production line (Plant). Deliberately
// lightweight: address/name/grouping only. Each Plant keeps its own
// currency/tax/geofence/tolerance settings rather than inheriting them
// from here, since those were already in daily use before multi-line
// sites existed and two lines at one site do sometimes run different
// batching tolerances in practice — a future request, not this one.
// What genuinely IS shared at the site level (raw-material silos/hoppers,
// via sharedAcrossPlants below) is scoped by siteId, not globally, so two
// unrelated sites' stock pools can never cross-contaminate each other.
// UI-terminology note: this model is displayed to users as "Plant" /
// "المصنع" (a physical factory location), and the Plant model below it is
// displayed as "Station" / "المحطة" (one production line inside that
// factory). The internal model/field names here (Site, Plant, siteId,
// plantId) were never renamed to match — only the label text was — since
// a full model rename is a far riskier migration for zero functional
// gain; every "site"/"plant" identifier in code still means exactly what
// it always did, it's only what the screen prints that changed.
model Site {
  id        String   @id @default(cuid())
  // Short, human-assigned business code ("S1", "CAI") — distinct from the
  // internal id, which nobody reads or types. What every other model's
  // "which site" filters and every report's site-scoping key off of
  // conceptually, even though the actual DB relation is still by id.
  code      String   @unique
  name      String
  city      String
  country   String?
  // Optional brand color ("#rrggbb") — when set, the whole app's accent
  // hue (buttons, links, chips, glow) switches to this plant/company's
  // own color for anyone viewing this site, in both light and dark theme
  // (see src/lib/accentColor.ts for how the rest of the accent family is
  // derived from this one value). Null means the default amber, exactly
  // as globals.css already defines it — nothing changes for a site that
  // never sets one.
  accentColor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plants                   Plant[]
  reservations             Reservation[]
  // Incentive policy/method lives at this level (Plant, in UI terms), not
  // the specific Station below — see the migration note on
  // DriverIncentivePolicy.
  incentivePolicies        DriverIncentivePolicy[]
  pumpIncentivePolicies    PumpIncentivePolicy[]
  incentiveMethods         IncentiveMethod[]
  opportunities            Opportunity[]
  quotes                   Quote[]
  purchaseOrders           PurchaseOrder[]
  maintenancePlans         MaintenancePlan[]
  maintenanceTickets       MaintenanceTicket[]
  supplierBills            SupplierBill[]
  cashTransactions         CashTransaction[]
  sparePartReceipts        SparePartReceipt[]
  sparePartsRequisitions   SparePartsRequisition[]
  materialRequisitions     MaterialRequisition[]
  finishedProductMovements FinishedProductMovement[]
  journalEntries           JournalEntry[]
  zatcaSettings            ZatcaSettings?
}

// A site's ZATCA (Saudi e-invoicing) registration — one row per site,
// since VAT/CR registration is a legal-entity/branch fact, not a
// production-line one. Deliberately holds only the non-secret identifiers
// a human types in from their CR/VAT certificate; the actual onboarded
// CSID certificate and private key (obtained via ZATCA's CSR -> OTP ->
// compliance-CSID -> production-CSID flow) are never stored here or
// anywhere in this database — they live in environment variables
// (ZATCA_CSID_CERT / ZATCA_CSID_SECRET, see src/lib/zatca/settings.ts),
// the same posture this app already takes for the database URL and blob
// storage token. onboardedAt is just a human-readable "did we finish that
// flow" marker, set manually once it has been.
//
// Every field here is optional — a site with no row (or an empty one)
// simply never generates ZATCA documents; nothing is fabricated in its
// place. See src/lib/zatca/ for the actual document generation/submission
// logic this configures.
model ZatcaSettings {
  id              String    @id @default(cuid())
  siteId          String    @unique
  site            Site      @relation(fields: [siteId], references: [id])
  sellerLegalName String?
  vatNumber       String? // 15-digit ZATCA VAT registration number
  crNumber        String? // Commercial Registration number
  environment     String    @default("SANDBOX") // SANDBOX, PRODUCTION
  onboardedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Plant {
  id                          String   @id @default(cuid())
  siteId                      String
  site                        Site     @relation(fields: [siteId], references: [id])
  // The production line's own label within its site ("Line 1", "خط 2") —
  // address/city/country live on Site above now, not duplicated here.
  name                        String
  // ACTIVE (normal), FROZEN (temporarily paused — new reservations/projects/
  // equipment/silos/material receipts against it are refused, but whatever
  // is already in flight or on file keeps working and stays visible), or
  // DECOMMISSIONED (the "delete a line" this app offers — same refusal as
  // FROZEN, just meant as permanent). Never a real row delete: too much
  // hangs off a Plant (silos, employees, trucks, batch tickets, invoices,
  // ...) for that to ever be safe — same convention as Employee/Truck/Pump.
  status                      String   @default("ACTIVE")
  currency                    String   @default("EGP")
  timezone                    String   @default("Africa/Cairo")
  // Applied to every invoice generated for this plant's projects, snapshotted
  // onto the invoice at generation time (see Invoice.taxRatePct) so a later
  // rate change never rewrites an already-issued invoice. taxLabel is the
  // name shown on the invoice ("VAT", "GST", "Sales Tax"...) since which
  // term applies depends on the plant's own jurisdiction, not the app.
  taxRatePct                  Float    @default(0)
  taxLabel                    String   @default("VAT")
  // A PurchaseOrder created against this plant's own site (see
  // resolvePlantIdForSite in purchasing/actions.ts, the same lookup
  // createPurchaseOrder already uses for currency/tax) whose total is at
  // or above this figure, in the plant's own currency, can't move past
  // DRAFT to SENT without approvePurchaseOrder first (see
  // markPurchaseOrderSent). Null/0 means no threshold is configured — the
  // existing no-approval-required behavior, unchanged for a plant that
  // never sets this.
  poApprovalThreshold         Float?
  // Batching tolerance & alert configuration (Module 12 — Plant Management).
  drumTimerLimitMinutes       Int      @default(90)
  returnAbsorptionThresholdM3 Float    @default(0.2)
  // Preventive-maintenance threshold, shared by trucks and pumps (see
  // src/lib/maintenance.ts) — a single per-plant number is simpler to
  // reason about than a per-vehicle one, matching the batching-tolerance
  // fields above.
  maintenanceIntervalTrips    Int      @default(150)
  // Geofenced yard — "a mixer counts as home once it is inside this
  // circle" (from the RhinoMaster review). Purely informational: the
  // telematics webhook computes distance on each ping and the Equipment
  // map shows an "at yard" badge, but nothing here ever overwrites a
  // truck's manually-set status. All three null means geofencing is off
  // for this plant.
  yardLat                     Float?
  yardLng                     Float?
  yardRadiusM                 Float?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  users            User[]
  silos            Silo[]
  hoppers          Hopper[]
  employees        Employee[]
  invoices         Invoice[]
  trucks           Truck[]
  batchTickets     BatchTicket[]
  pumps            Pump[]
  materialReceipts MaterialReceipt[]
  pumpCrewMembers  PumpCrewMember[]
  supportVehicles  SupportVehicle[]
  chemicalTanks    ChemicalTank[]
}

model Silo {
  id                  String    @id @default(cuid())
  plantId             String
  plant               Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name                String
  materialType        String
  capacityTons        Float
  currentLevelTons    Float     @default(0)
  minThresholdPct     Float     @default(15)
  lastCalibration     DateTime?
  // Populated by the SCADA sensor-reading webhook (see /api/scada/silo-reading)
  // to distinguish a sensor-fed level from a manual dashboard override.
  lastSensorReadingAt DateTime?
  // A cement/fly-ash tank feeding more than one production line at the
  // same site — plantId above is still the "home" line, but
  // completeBatch's consumption lookup (production/actions.ts) matches a
  // shared silo for ANY line's ticket at the SAME site, not just its own,
  // once this is true. Mirrors Hopper.sharedAcrossPlants below.
  sharedAcrossPlants  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  receipts MaterialReceipt[]
}

model Hopper {
  id                 String   @id @default(cuid())
  plantId            String
  plant              Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name               String
  aggregateType      String
  capacityTons       Float
  currentLevelTons   Float    @default(0)
  // Same low-stock threshold as Silo.minThresholdPct — drives the
  // dashboard alert and the auto-requisition check in completeBatch
  // (production/actions.ts), extended here so aggregate/water hoppers get
  // the same "flag it, then auto-request more" coverage cement silos
  // already had.
  minThresholdPct    Float    @default(15)
  // A yard heap multiple production lines at the same site draw from —
  // plantId above is still the "home"/organizational line, but
  // completeBatch's consumption lookup (production/actions.ts) matches a
  // shared hopper for any OTHER line's ticket at the SAME site (never a
  // different site), not just its own, once this is true.
  sharedAcrossPlants Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  receipts MaterialReceipt[]
}

// Liquid admixture inventory — separate from Silo/Hopper because it's
// tracked in liters, not tons, and a plant typically has one tank per
// specific admixture product rather than per material-type category.
// Wired into completeBatch's deduction loop the same way silos/hoppers
// are, converting a component's batched mass back to liters via the
// material's specific gravity (the inverse of the kg conversion
// addComponent already does when a mix recipe is entered in liters).
model ChemicalTank {
  id                 String   @id @default(cuid())
  plantId            String
  plant              Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material @relation(fields: [materialId], references: [id])
  name               String
  capacityLiters     Float?
  currentLevelLiters Float    @default(0)
  // Same low-stock threshold as Silo.minThresholdPct — only meaningful
  // once capacityLiters is set (a tank with no known capacity has no
  // percentage to compare against, so the completeBatch check skips it).
  minThresholdPct    Float    @default(15)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([plantId, materialId])
}

model MixDesign {
  id            String   @id @default(cuid())
  code          String   @unique
  grade         String
  exposureClass String?
  slumpTargetMm Float
  wcRatio       Float
  yieldTargetM3 Float    @default(1)
  status        String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, RETIRED
  standardCost  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  components       MixComponent[]
  reservations     Reservation[]
  batchTickets     BatchTicket[]
  certificates     ComplianceCertificate[]
  priceListEntries PriceListEntry[]
  opportunities    Opportunity[]
  quoteLines       QuoteLine[]
}

model Material {
  id              String    @id @default(cuid())
  name            String
  type            String // CEMENT, FLY_ASH, SAND, COARSE_AGGREGATE, ADMIXTURE, WATER
  brand           String?
  specificGravity Float?
  absorptionPct   Float?
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  // Manually-maintained standard cost (currency per kg) — not derived from
  // any actual receipt (MaterialReceipt carries no cost field; a receipt
  // can exist with or without a real PO behind it). Used by
  // getProfitabilityReport to price consumed mass; null means "no cost
  // data for this material yet", surfaced there rather than treated as 0.
  lastUnitCost    Float?
  // kg of embodied CO2e per kg of this material — same "manually
  // maintained, null means no data yet, never fabricated" shape as
  // lastUnitCost above. Prefilled from CO2E_FACTOR_KG_PER_KG (a standard
  // published industry figure per material type, src/lib/carbon.ts) when
  // a new Material is created, but always the plant's own number to
  // override once they have a real supplier EPD/factor — estimateCo2eKg
  // prefers this per-material figure and only falls back to the generic
  // table when it's null.
  co2FactorKgPerKg Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  mixComponents      MixComponent[]
  batchActuals       BatchComponentActual[]
  receipts           MaterialReceipt[]
  chemicalTanks      ChemicalTank[]
  purchaseOrderLines PurchaseOrderLine[]
  supplierContracts  SupplierContract[]
  requisitions       MaterialRequisition[]
}

model MixComponent {
  id                String    @id @default(cuid())
  mixId             String
  mix               MixDesign @relation(fields: [mixId], references: [id], onDelete: Cascade)
  materialId        String
  material          Material  @relation(fields: [materialId], references: [id])
  designMassKgPerM3 Float
  tolerancePct      Float     @default(2)
  // Display-only — the mass figure above stays the single source of truth
  // for every yield/tolerance calculation. Chemical admixtures are
  // conventionally dosed by volume on site; when set to LITER the
  // component table shows designMassKgPerM3 / material.specificGravity
  // instead of kg, without a second stored quantity to keep in sync.
  dosageUnit        String    @default("KG") // KG, LITER

  @@unique([mixId, materialId])
}

model Customer {
  id           String   @id @default(cuid())
  // Company-wide customer identifier — auto-generated as "C-00001" style
  // on create if left blank, or set by hand. Nullable/unique rather than
  // required so existing rows never need a forced backfill.
  code         String?  @unique
  legalName    String
  taxId        String?
  creditLimit  Float    @default(0)
  paymentTerms String   @default("Net 30")
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects         Project[]
  priceListEntries PriceListEntry[]
  invoices         Invoice[]
  opportunities    Opportunity[]
  fieldVisits      FieldVisit[]
  quotes           Quote[]
}

model Supplier {
  id               String   @id @default(cuid())
  name             String
  materialCatalog  String?
  leadTimeDays     Int?
  rejectionRatePct Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  materials            Material[]
  materialReceipts     MaterialReceipt[]
  purchaseOrders       PurchaseOrder[]
  contracts            SupplierContract[]
  bills                SupplierBill[]
  defaultForSpareParts SparePart[]
  sparePartReceipts    SparePartReceipt[]
}

// A customer's job site — company-wide, not tied to any one plant/line.
// Which plant actually produces for it is decided per Reservation (a big
// job site can be poured from whichever nearby line has capacity that
// day), not fixed at the project level.
model Project {
  id                 String   @id @default(cuid())
  name               String
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  siteAddress        String
  contractedVolumeM3 Float?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reservations  Reservation[]
  invoices      Invoice[]
  opportunities Opportunity[]
  quotes        Quote[]
}

model Reservation {
  id                    String     @id @default(cuid())
  // The human-facing booking number ("RES-2026-0001") shown wherever a
  // reservation appears — same globally-sequential, collision-safe
  // pattern as BatchTicket.ticketNumber (see withSequentialNumber in
  // src/lib/sequence.ts).
  reservationNumber     String     @unique
  projectId             String
  project               Project    @relation(fields: [projectId], references: [id])
  // Which factory (Site — see the UI-terminology note on that model) this
  // reservation is booked against. Deliberately NOT a specific production
  // line: at booking time only the factory is committed to, since the
  // customer/office side doesn't care and shouldn't have to care which of
  // that factory's stations actually produces it. The specific line is
  // chosen later, at batch-ticket release time (see BatchTicket.plantId
  // in Production) — that's the operational decision, made when it's
  // actually known which station has capacity right now.
  siteId                String
  site                  Site       @relation(fields: [siteId], references: [id])
  mixId                 String
  mix                   MixDesign  @relation(fields: [mixId], references: [id])
  requestedVolumeM3     Float
  // Snapshotted once at creation and never touched again by
  // updateReservation — requestedVolumeM3 above is the current (possibly
  // revised) figure, this is what was actually booked first, so a report
  // can show "booked 21, now 39" instead of losing the revision history
  // (from the Dynamics Job Qty / Net Qty comparison). Null on rows created
  // before this field existed; treat null as "same as requestedVolumeM3."
  originalVolumeM3      Float?
  pourWindowStart       DateTime
  status                String     @default("REQUESTED") // REQUESTED, CONFIRMED, IN_PRODUCTION, DELIVERED, CANCELLED
  // Pour-order details captured at intake — distinct from the mix design's
  // own slump target, since site conditions can call for an adjustment on
  // the day (e.g. a pump mix run wetter than the design slump).
  slumpRequestedMm      Float?
  // How far the measured slump may miss slumpRequestedMm and still pass —
  // separate from the fixed SLUMP_TOLERANCE_MM the Reports module uses as
  // a plant-wide default, since a specific pour can call for a tighter or
  // looser band. Null means "use the plant-wide default."
  slumpToleranceMm      Float?
  // Printed on the delivery ticket when the job specifies one — OPC or
  // SRC. Null means the job didn't ask, not "OPC by default": leaving it
  // unset is a real, distinct state from choosing OPC.
  cementType            String?
  // Maximum concrete temperature allowed at discharge — a real rejection
  // threshold checked against TestBatch.concreteTempC when a sample is
  // logged (see Quality), not just an informational number on the ticket.
  temperatureC          Float?
  siteLocation          String?
  // A pasted maps share link, sent straight to the driver — simpler and
  // more directly actionable on site than structured lat/lng would be.
  siteLocationUrl       String?
  siteContactName       String?
  siteContactPhone      String?
  deliveryMethod        String?    @default("CHUTE") // PUMP, CHUTE
  // Free-text specific label ("Column C12", "Slab L3") — distinct from
  // structureType below, which is the fixed category used for reporting.
  structuralElement     String?
  // FOUNDATION, SLAB, COLUMN, COLUMN_NECK, BEAM, ROOF, RAFT, OTHER — a fixed
  // list (from the RhinoMaster/Dynamics comparison) so "how much concrete
  // went into columns this month" is a real query, not a free-text guess.
  structureType         String?
  // Required boom/line reach for a pump delivery — checked against
  // Pump.reachM when assigning a pump on the trip-start form (see
  // production/[id]/page.tsx), the same kind of real validation threshold
  // temperatureC already is for concrete temperature.
  minPumpReachM         Float?
  labTechnicianRequired Boolean    @default(false)
  // Two-stage sign-off gate a reservation must clear before Production will
  // release a batch ticket against it — distinct from `status` above, which
  // tracks the delivery lifecycle rather than who signed off. Initial is
  // the reservations officer confirming the booking itself is sound; final
  // is operations management clearing it to actually be produced. Both
  // null means "not yet activated," same meaning whether the reservation
  // was just created or was edited enough to warrant re-approval.
  initialApprovedAt     DateTime?
  initialApprovedById   String?
  initialApprovedBy     User?      @relation("ReservationInitialApproval", fields: [initialApprovedById], references: [id])
  finalApprovedAt       DateTime?
  finalApprovedById     String?
  finalApprovedBy       User?      @relation("ReservationFinalApproval", fields: [finalApprovedById], references: [id])
  // Set only by closeReservation (the "end this reservation now" action) —
  // a structured reason (from the Dynamics ModCancelReason comparison,
  // same style as DrumReturn.reasonCode) plus an optional free-text note,
  // so closing early is an accountable action, not a silent status flip.
  closedAt              DateTime?
  closedById            String?
  closedBy              User?      @relation("ReservationClosedBy", fields: [closedById], references: [id])
  closeReasonCode       String?
  closeNote             String?
  // Free-text notes captured at booking time (site/pump/timing remarks) —
  // distinct from the structured pour-detail fields above, same role as
  // RhinoMaster's "Remarks" field on its own booking form.
  notes                 String?
  // Stamped when someone sends the pre-pour WhatsApp reminder (see
  // reservationsDueForReminder in src/lib/reservations.ts and
  // markReservationReminderSent in reservations/actions.ts) — the send
  // itself is a manual wa.me click (no WhatsApp Business API account is
  // wired up), so this only records that a human did it, not that the
  // message was actually delivered/read. Null keeps the reservation in the
  // "due for reminder" list.
  reminderSentAt        DateTime?
  // Set when this reservation was created by converting an accepted
  // QuoteLine (see convertQuoteLineToReservation in sales/actions.ts) —
  // traceability back to the price offer that led to the booking. Null for
  // every reservation created the normal way (createReservation /
  // createManualRelease).
  quoteLineId           String?    @unique
  quoteLine             QuoteLine? @relation(fields: [quoteLineId], references: [id])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  batchTickets    BatchTicket[]
  pumpAssignments PumpAssignment[]
}

model Employee {
  id                         String    @id @default(cuid())
  plantId                    String
  plant                      Plant     @relation(fields: [plantId], references: [id])
  name                       String
  role                       String
  // Per-employee identifier (badge/payroll number) — distinct from `role`,
  // which is the job title. Optional and unique when set; Postgres allows
  // any number of NULLs under a unique constraint, so employees without a
  // code on file never collide.
  code                       String?   @unique
  licenseNumber              String?
  licenseExpiry              DateTime?
  shiftPattern               String?
  // ACTIVE, FROZEN (temporarily suspended, kept on file), REMOVED (soft
  // delete — never a real row delete, same reasoning as User.status: the
  // employee's trip/receipt history must keep resolving to a real name).
  // "Transfer to another plant" is just editing plantId above, not a
  // separate status value.
  status                     String    @default("ACTIVE")
  // Days per calendar year — HR's own default (21, a common regional
  // labor-law minimum), overridable per employee. Purely informational
  // context shown next to a new leave request (see leave/actions.ts);
  // nothing here hard-blocks a request that would exceed it, since real
  // policies sometimes allow unpaid overflow.
  annualLeaveEntitlementDays Int       @default(21)
  // Optional on purpose — payroll runs simply skip any employee missing
  // either field, so existing rows (and roles this doesn't apply to) never
  // break. wageRate is per-month when wageType is MONTHLY, per-day when DAILY.
  wageType                   String?
  wageRate                   Float?
  // GOSI (Saudi social insurance) eligibility and rate overrides — Saudi
  // nationals contribute to the annuities branch, non-Saudis don't (see
  // GOSI_DEFAULTS in payroll/actions.ts). The two rate fields are null by
  // default (use the nationality-based default); set them only to record
  // an actual different rate for one employee, same override shape as
  // annualLeaveEntitlementDays above.
  isSaudiNational            Boolean   @default(true)
  employeeGosiRatePct        Float?
  employerGosiRatePct        Float?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  trips                     Trip[]
  sampledTestBatches        TestBatch[]
  materialReceiptsDriven    MaterialReceipt[]
  defaultForTrucks          Truck[]
  defaultForSupportVehicles SupportVehicle[]
  user                      User?
  attendanceRecords         AttendanceRecord[]
  leaveRequests             LeaveRequest[]
  maintenanceOrders         MaintenanceOrderTechnician[]
  payrollLines               PayrollLine[]
}

model PayrollRun {
  id           String    @id @default(cuid())
  runNumber    String    @unique // PYR-YYYY-NNNN
  periodStart  DateTime
  periodEnd    DateTime
  status       String    @default("DRAFT") // DRAFT, APPROVED, PAID, CANCELLED
  createdById  String
  createdBy    User      @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines PayrollLine[]
}

model PayrollLine {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  // wageType/wageRate snapshotted from Employee at generation time, so a
  // later change to the employee's rate never reshapes an already-generated
  // (or already-paid) run.
  wageType     String
  wageRate     Float
  periodDays   Int
  // ABSENT attendance days + UNPAID approved leave days overlapping the
  // period — see generatePayrollRun for the exact query.
  unpaidDays   Float
  grossPay     Float
  // GOSI computed off grossPay at generation time, at whatever rate was
  // effective for the employee then (see generatePayrollRun). employeeGosi
  // is deducted into netPay below; employerGosi is the company's own
  // additional cost — never deducted from the employee, but real cash cost
  // (see markPayrollRunPaid, which folds both into the posted transaction).
  employeeGosi Float      @default(0)
  employerGosi Float      @default(0)
  // Pulled automatically from src/lib/incentives.ts for the same period,
  // for the three incentive roles backed by a real Employee record
  // (MIXER_DRIVER, BULKER_DRIVER, WATER_TANKER_DRIVER — see
  // generatePayrollRun). PUMP_OPERATOR/PUMP_ASSISTANT are excluded: their
  // incentive activity is keyed by PumpCrewMember.id, a separate roster
  // with no link to Employee, so there is no reliable id to match against
  // a payroll line. Added to netPay below, same as employeeGosi is
  // subtracted from it — not editable directly (adjustment is still the
  // manual override for anything this doesn't cover).
  incentiveAmount Float   @default(0)
  // Manual +/- (bonus or extra deduction), editable only while the run is
  // DRAFT.
  adjustment   Float      @default(0)
  netPay       Float
  notes        String?

  @@unique([payrollRunId, employeeId])
}

// ---------------------------------------------------------------------------
// HR — daily attendance and leave requests, both keyed to the same Employee
// roster the rest of the app already uses (no separate HR-only person
// table). Recorded by whoever has Employees access (an admin/plant admin),
// same as the roster itself — this app has no employee self-service portal
// anywhere, so "who requested/recorded" is always a staff member acting on
// the employee's behalf, tracked via recordedById/requestedById.
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  // Day-level, not a timestamp — checkInAt/checkOutAt below carry the
  // actual times when known. One row per employee per calendar day (see
  // the unique constraint), so re-recording the same day is always an
  // update, never a duplicate.
  date         DateTime
  checkInAt    DateTime?
  checkOutAt   DateTime?
  status       String    @default("PRESENT") // PRESENT, ABSENT, LATE, HALF_DAY, ON_LEAVE, HOLIDAY
  notes        String?
  recordedById String
  recordedBy   User      @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id            String    @id @default(cuid())
  requestNumber String    @unique // LV-YYYY-NNNN
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  type          String // ANNUAL, SICK, UNPAID, EMERGENCY, OTHER
  startDate     DateTime
  endDate       DateTime
  // Inclusive day count, computed once at creation from startDate/endDate
  // — snapshotted rather than always recomputed so an edit to how "days"
  // gets calculated later never silently rewrites an already-decided
  // request's own numbers, same reasoning as Invoice/Quote snapshotting
  // their tax rate at generation time.
  daysCount     Float
  reason        String?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById  String?
  approvedBy    User?     @relation("LeaveApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectionNote String?
  requestedById String
  requestedBy   User      @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Admin-managed job-title catalog — supplements the hardcoded role list on
// the Employees "admin" tab (office/support roles) so a new position can be
// added from the screen itself instead of a code change. Org-wide, not
// per-plant: a job title like "Batching Technician" isn't specific to one
// site. Employee.role stays a plain string either way (see the comment on
// that field) — this table just feeds the picker with more options over
// time.
model JobTitle {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Material Receiving
// ---------------------------------------------------------------------------

model MaterialReceipt {
  id                  String             @id @default(cuid())
  plantId             String
  plant               Plant              @relation(fields: [plantId], references: [id])
  supplierId          String
  supplier            Supplier           @relation(fields: [supplierId], references: [id])
  materialId          String
  material            Material           @relation(fields: [materialId], references: [id])
  // Free-text, kept exactly as it always was — an ad-hoc buy with no
  // formal PurchaseOrder on file still works. purchaseOrderLineId below
  // is the NEW, optional link to a real order line (see receiveAgainst
  // PurchaseOrder in purchasing/actions.ts); a receipt can have one, the
  // other, both, or neither.
  poNumber            String?
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  orderedMassKg       Float?
  grossWeightKg       Float
  tareWeightKg        Float
  netWeightKg         Float
  moisturePct         Float?
  qcStatus            String             @default("PENDING") // PENDING, PASSED, HELD, REJECTED
  postedToInventory   Boolean            @default(false)
  destinationSiloId   String?
  destinationSilo     Silo?              @relation(fields: [destinationSiloId], references: [id])
  destinationHopperId String?
  destinationHopper   Hopper?            @relation(fields: [destinationHopperId], references: [id])
  // Who physically drove this delivery — a cement bulker for a CEMENT
  // receipt, a water tanker for a WATER one. Optional and free-text-
  // capable like Trip's pump-crew fields: pick from the roster (an
  // Employee with role BULKER_DRIVER/WATER_TANKER_DRIVER) when possible,
  // but a delivery can still be logged with just a typed name. Feeds the
  // per-role incentive tables on the Incentives page (src/lib/incentives.ts).
  driverId            String?
  driver              Employee?          @relation(fields: [driverId], references: [id])
  driverName          String?
  receivedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 2 — Production & Fleet
// ---------------------------------------------------------------------------

model Truck {
  id                String    @id @default(cuid())
  plantId           String
  plant             Plant     @relation(fields: [plantId], references: [id])
  code              String
  drumCapacityM3    Float
  maxAgitationRpm   Float?
  gpsDeviceId       String?
  // Registration details — optional since older/imported records may not
  // have them on file yet; nothing downstream depends on these being set.
  year              Int?
  chassisNumber     String?
  plateNumber       String?
  // Regulatory compliance dates — same optional/informational role as the
  // registration fields above. licenseValidFrom is purely informational
  // (when the vehicle license became valid); the other two are real
  // deadlines the equipment list flags as they approach/pass, same
  // pattern as Employee.licenseExpiry.
  licenseValidFrom        DateTime?
  periodicInspectionDueAt DateTime?
  operatingCardExpiry     DateTime?
  // Same real-deadline shape as operatingCardExpiry above — flagged by the
  // Equipment screen's own expiryFlag the same way once it approaches/
  // passes, not just informational like licenseValidFrom.
  insurancePolicyExpiry   DateTime?
  // Pre-fills the driver field when this truck is picked to start a trip
  // (see startTrip/updateTripAssignment) — still just a default, not a
  // lock: the operator can always pick someone else for that specific trip.
  defaultDriverId   String?
  defaultDriver     Employee? @relation(fields: [defaultDriverId], references: [id])
  status            String    @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE, OUT_OF_SERVICE
  // Populated by the GPS telematics webhook (see /api/telematics/ping).
  lastLat           Float?
  lastLng           Float?
  lastPingAt        DateTime?
  // Reset by the "mark serviced" action — trips since this date (via
  // Trip.batchTime) feed the due-for-inspection flag in
  // src/lib/maintenance.ts. Null means "never recorded," which counts
  // every trip ever as "since last maintenance."
  lastMaintenanceAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  trips Trip[]
}

// A batch ticket is released against a confirmed reservation. Component
// targets are snapshotted from the mix design at release time (scaled to
// the requested volume) so a later mix-design edit never silently changes
// a ticket that has already been batched.
model BatchTicket {
  id               String      @id @default(cuid())
  reservationId    String
  reservation      Reservation @relation(fields: [reservationId], references: [id])
  mixId            String
  mix              MixDesign   @relation(fields: [mixId], references: [id])
  plantId          String
  plant            Plant       @relation(fields: [plantId], references: [id])
  ticketNumber     String      @unique
  volumeM3         Float
  status           String      @default("RELEASED") // RELEASED, BATCHING, COMPLETE, CANCELLED
  releasedAt       DateTime    @default(now())
  batchCompletedAt DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  components BatchComponentActual[]
  trip       Trip?
  wasteMemos WasteIncidentMemo[]
}

model BatchComponentActual {
  id            String      @id @default(cuid())
  batchTicketId String
  batchTicket   BatchTicket @relation(fields: [batchTicketId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material    @relation(fields: [materialId], references: [id])
  targetMassKg  Float
  actualMassKg  Float?
  moisturePct   Float?

  @@unique([batchTicketId, materialId])
}

model Trip {
  id                   String          @id @default(cuid())
  batchTicketId        String          @unique
  batchTicket          BatchTicket     @relation(fields: [batchTicketId], references: [id])
  truckId              String
  truck                Truck           @relation(fields: [truckId], references: [id])
  driverId             String
  driver               Employee        @relation(fields: [driverId], references: [id])
  // Only set when the reservation's delivery method is PUMP — the specific
  // pump unit and crew placing this load, as distinct from the pump
  // booking calendar (PumpAssignment), which schedules a pump against a
  // reservation for billing hours rather than recording who ran it.
  pumpId               String?
  pump                 Pump?           @relation(fields: [pumpId], references: [id])
  // Free-text name is still the field every read path renders — picking a
  // crew member below just fills it from PumpCrewMember.name at write time
  // (see startTrip), so a trip can still name someone off-roster without
  // forcing every operator into master data on day one.
  pumpOperatorName     String?
  pumpAssistantName    String?
  pumpOperatorId       String?
  pumpOperatorCrew     PumpCrewMember? @relation("PumpOperatorCrew", fields: [pumpOperatorId], references: [id])
  pumpAssistantId      String?
  pumpAssistantCrew    PumpCrewMember? @relation("PumpAssistantCrew", fields: [pumpAssistantId], references: [id])
  status               String          @default("LOADING") // LOADING, IN_TRANSIT, ON_SITE, DISCHARGING, CLOSED
  batchTime            DateTime        @default(now())
  departTime           DateTime?
  arriveTime           DateTime?
  dischargeStart       DateTime?
  dischargeEnd         DateTime?
  volumeDeliveredM3    Float?
  // How much of THIS ticket's own volume was fulfilled by topping up
  // reclaimed material already in the truck's drum, rather than freshly
  // batched — set by startTrip when the chosen truck has an unconsumed
  // RECLAIMED DrumReturn for a matching mix (see src/lib/reclaim.ts).
  // Never reduces BatchTicket.volumeM3 itself — the customer is still
  // billed/ticketed for the full amount; only the component target
  // masses drawn from inventory shrink by this much.
  reclaimedVolumeM3    Float?
  // Driver-app delivery confirmation photo — a real Vercel Blob URL (see
  // src/lib/blob.ts and uploadDeliveryPhoto in src/app/driver/actions.ts),
  // not a data: URI stored in the row.
  deliveryPhotoUrl     String?
  deliverySignedBy     String?
  deliverySignedAt     DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  drumReturn         DrumReturn?
  // The (different, earlier) DrumReturn this trip itself consumed by
  // topping up a truck's leftover reclaimed material — opposite side of
  // DrumReturn.consumedInTripId above. Distinct from `drumReturn`, which
  // is whatever THIS trip returns when IT closes.
  consumedDrumReturn DrumReturn?  @relation("ReclaimConsumedInTrip")
  testBatches        TestBatch[]
  invoiceLine        InvoiceLine?
}

model DrumReturn {
  id                String    @id @default(cuid())
  tripId            String    @unique
  trip              Trip      @relation(fields: [tripId], references: [id])
  returnedVolumeM3  Float
  minutesSinceBatch Int
  disposition       String // NO_CHARGE, REDISPATCHED, PARTIAL_CREDIT, FULL_WASTE
  // Why the load came back — orthogonal to disposition, which is the
  // time/volume-driven financial outcome. Unrecorded until now (from the
  // RhinoMaster/Dynamics return-ticket comparison): CUSTOMER_CANCELLED,
  // SITE_NOT_READY, OVER_ORDERED, ACCESS_BLOCKED, QUALITY_REJECTED,
  // TRAFFIC_DELAY, OTHER.
  reasonCode        String?
  // What physically happened to the returned concrete — DUMPED or
  // RECLAIMED (fed into a reclaimer / reused in another batch). Also
  // unrecorded until now; independent of disposition and reasonCode.
  fate              String?
  note              String?
  // Set once a LATER trip on the same truck actually tops this reclaimed
  // load up with fresh material and reuses it — distinguishes "flagged
  // reclaimable, still sitting in the drum" from "already reused," so a
  // truck's current drum content can be derived from its most recent
  // CLOSED trip's own DrumReturn (see getAvailableReclaimForTruck in
  // src/lib/reclaim.ts) without a separate stored "current drum content"
  // field on Truck.
  consumedAt        DateTime?
  consumedInTripId  String?   @unique
  consumedInTrip    Trip?     @relation("ReclaimConsumedInTrip", fields: [consumedInTripId], references: [id])
  createdAt         DateTime  @default(now())

  wasteMemo WasteIncidentMemo?
}

// Auto-created alongside a DrumReturn whenever a load is closed with
// reasonCode QUALITY_REJECTED — a formal, approvable record of the waste
// event (as distinct from the return-billing reduction on Trip.volumeDeliveredM3,
// which happens regardless of whether this memo is ever approved). Quality
// signs off on it from the Quality module; the sign-off is surfaced back on
// the original ticket and its supplement document.
model WasteIncidentMemo {
  id             String      @id @default(cuid())
  drumReturnId   String      @unique
  drumReturn     DrumReturn  @relation(fields: [drumReturnId], references: [id])
  batchTicketId  String
  batchTicket    BatchTicket @relation(fields: [batchTicketId], references: [id])
  wastedVolumeM3 Float
  reasonCode     String
  status         String      @default("PENDING") // PENDING, APPROVED
  // The written explanation of what was actually found wrong with the
  // load — required at approval time (see approveWasteMemo in
  // quality/actions.ts), since reasonCode alone is just the coarse
  // category picked from the return-close dropdown, not a real QA
  // finding. Null until approved.
  approvalNote   String?
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?       @relation("WasteMemoApproval", fields: [approvedById], references: [id])
  createdAt      DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Phase 3 — Quality & Compliance
// ---------------------------------------------------------------------------

model TestBatch {
  id              String    @id @default(cuid())
  tripId          String
  trip            Trip      @relation(fields: [tripId], references: [id])
  sampleType      String    @default("CYLINDER") // CYLINDER, CUBE, SLUMP_ONLY
  sampleTime      DateTime  @default(now())
  slumpMeasuredMm Float?
  airContentPct   Float?
  concreteTempC   Float?
  sampledById     String?
  sampledBy       Employee? @relation(fields: [sampledById], references: [id])
  createdAt       DateTime  @default(now())

  labResults LabResult[]
}

model LabResult {
  id                String    @id @default(cuid())
  testBatchId       String
  testBatch         TestBatch @relation(fields: [testBatchId], references: [id], onDelete: Cascade)
  ageDays           Int
  breakStrengthMpa  Float
  targetStrengthMpa Float
  passFail          String // PASS, FAIL
  testedOn          DateTime  @default(now())
  createdAt         DateTime  @default(now())

  capa CapaRecord?
}

// Corrective and Preventive Action — auto-opened by addLabResult the
// instant a LabResult comes back FAIL (see quality/actions.ts), so a
// failed strength test can't just sit there as a chip on a table with
// nobody assigned to explain why or fix it, closing the "silent failure"
// gap a FAIL result previously left. One CAPA per failed result
// (labResultId unique) — root cause/actions/responsible/due date start
// blank and get filled in afterward by Quality; status moves OPEN →
// IN_PROGRESS the first time those details are saved, → CLOSED only once
// both rootCause and correctiveAction are actually on file (same "the
// reason must be written" precedent as WasteIncidentMemo.approvalNote).
model CapaRecord {
  id               String     @id @default(cuid())
  capaNumber       String     @unique // CAPA-YYYY-NNNN
  labResultId      String     @unique
  labResult        LabResult  @relation(fields: [labResultId], references: [id])
  status           String     @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  rootCause        String?
  correctiveAction String?
  preventiveAction String?
  responsibleId    String?
  responsible      User?      @relation("CapaResponsible", fields: [responsibleId], references: [id])
  dueDate          DateTime?
  closedAt         DateTime?
  closedById       String?
  closedBy         User?      @relation("CapaClosedBy", fields: [closedById], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model ComplianceCertificate {
  id          String    @id @default(cuid())
  mixId       String
  mix         MixDesign @relation(fields: [mixId], references: [id])
  standardRef String
  issuedDate  DateTime
  expiryDate  DateTime
  issuingBody String
  documentUrl String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Pumps
// ---------------------------------------------------------------------------

model Pump {
  id                 String          @id @default(cuid())
  plantId            String
  plant              Plant           @relation(fields: [plantId], references: [id])
  code               String
  pumpType           String // BOOM, LINE, STATIONARY
  reachM             Float?
  hourlyRate         Float
  standbyRate        Float?
  // Registration details, same optional/informational role as on Truck.
  year               Int?
  chassisNumber      String?
  plateNumber        String?
  // Regulatory compliance dates — same shape as Truck's own.
  licenseValidFrom        DateTime?
  periodicInspectionDueAt DateTime?
  operatingCardExpiry     DateTime?
  // Same real-deadline shape as operatingCardExpiry above — flagged by the
  // Equipment screen's own expiryFlag the same way once it approaches/
  // passes, not just informational like licenseValidFrom.
  insurancePolicyExpiry   DateTime?
  // Pre-fill the operator/assistant fields when this pump is picked to
  // start a pump-delivery trip — still just defaults, always overridable
  // for that specific trip (see startTrip/updateTripAssignment).
  defaultOperatorId  String?
  defaultOperator    PumpCrewMember? @relation("PumpDefaultOperator", fields: [defaultOperatorId], references: [id])
  defaultAssistantId String?
  defaultAssistant   PumpCrewMember? @relation("PumpDefaultAssistant", fields: [defaultAssistantId], references: [id])
  status             String          @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE, OUT_OF_SERVICE
  // Same due-for-inspection mechanism as Truck.lastMaintenanceAt.
  lastMaintenanceAt  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignments PumpAssignment[]
  trips       Trip[]
}

// Not @unique on reservationId — a large pour can need more than one pump
// working simultaneously, so a reservation may carry several assignments.
model PumpAssignment {
  id              String          @id @default(cuid())
  pumpId          String
  pump            Pump            @relation(fields: [pumpId], references: [id])
  reservationId   String
  reservation     Reservation     @relation(fields: [reservationId], references: [id])
  scheduledStart  DateTime
  billedHours     Float?
  status          String          @default("SCHEDULED") // SCHEDULED, ON_SITE, COMPLETE, CANCELLED
  // Crew reserved for this pump at booking time — same free-choice pattern
  // as Trip's own pumpOperatorId/pumpAssistantId (optional, from the
  // company-wide PumpCrewMember roster; not required to match the pump's
  // own default crew). Set from the New Booking form's pump section; the
  // trip actually dispatched later can still pick different crew.
  pumpOperatorId  String?
  pumpOperator    PumpCrewMember? @relation("PumpAssignmentOperator", fields: [pumpOperatorId], references: [id])
  pumpAssistantId String?
  pumpAssistant   PumpCrewMember? @relation("PumpAssignmentAssistant", fields: [pumpAssistantId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 6 — Billing (pricing, invoicing, AR)
// ---------------------------------------------------------------------------

model PriceListEntry {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mixId      String
  mix        MixDesign @relation(fields: [mixId], references: [id])
  pricePerM3 Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([customerId, mixId])
}

// One invoice per generation run against a project's not-yet-invoiced closed
// trips — see generateInvoiceForProject. Status is a simple linear flow
// (DRAFT -> SENT -> PAID, or CANCELLED); "overdue" is deliberately NOT a
// stored status — it's derived at display time from dueDate + payments, the
// same pattern the app already uses for certificate expiry, so there's no
// background job to keep it in sync.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  // Which line the invoiced trips were actually produced at — a project
  // itself carries no plant (see the Project model comment), so this is
  // snapshotted from the trips' own reservation.plantId at generation
  // time. Nullable for the same reason projectId is: an invoice with no
  // project can't resolve one either. One invoice never mixes trips from
  // more than one plant (see generateInvoiceForProject) specifically so
  // this field — and the tax rate below — always means one real thing.
  plantId       String?
  plant         Plant?   @relation(fields: [plantId], references: [id])
  status        String   @default("DRAFT") // DRAFT, SENT, PAID, CANCELLED
  issueDate     DateTime @default(now())
  dueDate       DateTime
  subtotal      Float
  // Snapshotted from Plant.taxRatePct/taxLabel at generation time — the
  // plant's rate can change later without altering an already-issued
  // invoice's own numbers.
  taxRatePct    Float    @default(0)
  taxLabel      String   @default("VAT")
  taxAmount     Float    @default(0)
  total         Float
  currency      String   @default("EGP")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ZATCA e-invoicing (Saudi Arabia) — populated by
  // src/lib/zatca/generate.ts once this invoice's site has ZatcaSettings
  // on file. All null until then: no QR, no XML, no status, nothing
  // fabricated in their place. zatcaStatus is GENERATED (documents built,
  // not yet sent — Phase 1 QR compliance already met at this point),
  // CLEARED (Phase 2: accepted by ZATCA's clearance API), or FAILED.
  zatcaUuid        String?
  // SHA256 of this invoice's own generated XML, and the prior CLEARED
  // invoice's own zatcaInvoiceHash — ZATCA requires each invoice to chain
  // to the one before it (Previous Invoice Hash), the same tamper-evidence
  // idea as a blockchain, so an invoice can't be quietly inserted or
  // altered after the fact.
  zatcaInvoiceHash String?
  zatcaPreviousHash String?
  // Base64 TLV payload — Phase 1's 5-tag shape (seller name, VAT number,
  // timestamp, total, VAT total). Phase 2 extends this to 9 tags once a
  // real CSID exists to compute the signature/certificate tags.
  zatcaQrCode       String?
  zatcaXml          String?
  zatcaStatus       String?
  zatcaGeneratedAt  DateTime?
  zatcaSubmittedAt  DateTime?
  zatcaClearedAt    DateTime?
  zatcaErrorMessage String?

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
}

// One line per delivered trip — the delivery ticket is the natural billing
// unit in ready-mix, not the reservation (a split reservation bills as
// several lines, possibly across several invoices).
model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tripId      String  @unique
  trip        Trip    @relation(fields: [tripId], references: [id])
  description String
  volumeM3    Float
  unitPrice   Float
  lineTotal   Float
}

model Payment {
  id           String    @id @default(cuid())
  invoiceId    String
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Float
  paidAt       DateTime  @default(now())
  method       String? // CASH, BANK_TRANSFER, CHEQUE
  reference    String?
  // Manual bank reconciliation — see the Finance module's own section
  // comment (near SupplierBill) for why this is a hand-matched flag
  // rather than a real bank-feed import.
  reconciled   Boolean   @default(false)
  reconciledAt DateTime?
  createdAt    DateTime  @default(now())
}

// A discount/credit against a specific invoice (return, price dispute,
// goodwill gesture, correction) — reduces what the customer still owes the
// same way a Payment does, but no cash actually changed hands, so this
// never appears in the Reconciliation tab (no `reconciled` field, unlike
// Payment). Every "what's still owed" calculation site treats total minus
// payments minus creditNotes as the real amount due — see
// src/lib/billing.ts's invoiceAmountDue.
model CreditNote {
  id               String   @id @default(cuid())
  creditNoteNumber String   @unique // CN-YYYY-NNNN
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Float
  reason           String // RETURN, PRICE_ADJUSTMENT, QUALITY_ISSUE, GOODWILL, OTHER
  notes            String?
  issuedById       String
  issuedBy         User     @relation(fields: [issuedById], references: [id])
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Sales Management — the funnel that happens before a Reservation exists:
// a prospect is contacted, a site is visited, a price offer goes out, and
// only once it's accepted does a real Reservation get created (see
// convertQuoteLineToReservation in sales/actions.ts, the same
// "convert X into Y" shape releaseTicketForReservation already uses in
// production/actions.ts).
// ---------------------------------------------------------------------------

model Opportunity {
  id                  String     @id @default(cuid())
  // Human-facing code ("OPP-2026-0001") — same withSequentialNumber
  // pattern as Reservation.reservationNumber / BatchTicket.ticketNumber.
  opportunityNumber   String     @unique
  customerId          String?
  customer            Customer?  @relation(fields: [customerId], references: [id])
  // Used until/unless a real Customer exists — same optional-FK-plus-
  // free-text-fallback shape as MaterialReceipt.driverId/driverName. See
  // promoteProspectToCustomer, which creates the real Customer row and
  // backfills customerId once the deal is real enough to be one.
  prospectName        String?
  prospectPhone       String?
  prospectEmail       String?
  projectId           String?
  project             Project?   @relation(fields: [projectId], references: [id])
  // Booked-at-the-factory level, same as Reservation.siteId — the specific
  // station is still a production-time decision, not a sales one.
  siteId              String
  site                Site       @relation(fields: [siteId], references: [id])
  mixId               String?
  mix                 MixDesign? @relation(fields: [mixId], references: [id])
  estimatedVolumeM3   Float?
  // NEW, CONTACTED, SITE_VISIT, QUOTED, NEGOTIATION, WON, LOST — a plain
  // linear pipeline, same status-as-string-plus-comment convention as
  // BatchTicket.status/Trip.status. WON/LOST are terminal; nothing here
  // enforces the order beyond what advanceOpportunityStage checks.
  status              String     @default("NEW")
  // Set only when status moves to LOST — accountable, not a silent drop,
  // same reasoning as Reservation.closeReasonCode.
  lostReasonCode      String?
  source              String? // REFERRAL, WEBSITE, COLD_CALL, REPEAT_CUSTOMER, OTHER
  // Set to whoever created the record (Sales Rep, Sales Supervisor, or
  // Sales Manager — see createOpportunity) and never reassigned away by
  // this app's own actions, so it doubles as the creator-attribution field
  // the two-stage approval chain below is scoped by. A later hand-off of
  // day-to-day ownership is still just editing this field, same as before.
  ownerId             String?
  owner               User?      @relation("OpportunityOwner", fields: [ownerId], references: [id])
  expectedCloseDate   DateTime?
  notes               String?
  // Two-stage sign-off, same field shape (and name) as Reservation's own
  // initialApprovedAt/finalApprovedAt — initial from the Sales Supervisor,
  // final from the Sales Manager (see approveInitialStage/approveFinalStage
  // in sales/actions.ts). Required before advanceOpportunityStage will
  // accept a move to WON; never required for any other stage, so the
  // pipeline itself is never blocked while a deal is still being worked.
  // If the Sales Manager approves directly while initial is still empty,
  // approveFinalStage backfills initial as the same manager/timestamp —
  // a senior role's direct approval covers the junior stage, it doesn't
  // require it first.
  initialApprovedAt   DateTime?
  initialApprovedById String?
  initialApprovedBy   User?      @relation("OpportunityInitialApproval", fields: [initialApprovedById], references: [id])
  finalApprovedAt     DateTime?
  finalApprovedById   String?
  finalApprovedBy     User?      @relation("OpportunityFinalApproval", fields: [finalApprovedById], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  visits FieldVisit[]
  quotes Quote[]
}

model FieldVisit {
  id                  String       @id @default(cuid())
  // Human-facing code ("FV-2026-0001") — same withSequentialNumber pattern
  // as every other document number in this schema.
  visitNumber         String       @unique
  opportunityId       String?
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id])
  customerId          String?
  customer            Customer?    @relation(fields: [customerId], references: [id])
  visitedById         String
  visitedBy           User         @relation("FieldVisitVisitedBy", fields: [visitedById], references: [id])
  visitDate           DateTime     @default(now())
  purpose             String? // INTRO, FOLLOW_UP, SITE_SURVEY, COMPLAINT, OTHER
  locationName        String?
  // Maps link — same field shape as Reservation.siteLocationUrl. No device
  // geolocation capture; see the plan's "explicitly out of scope" note.
  locationUrl         String?
  notes               String
  // Same data-URL-in-column stopgap as Trip.deliveryPhotoDataUrl — swap
  // for a real blob store before production photo volume.
  photoDataUrl        String?
  followUpDate        DateTime?
  // Two-stage sign-off — same shape and skip rule as Opportunity's, see
  // that model's comment. A field visit is a record of something that
  // already happened, so this is a review/sign-off trail rather than a
  // gate on any action here.
  initialApprovedAt   DateTime?
  initialApprovedById String?
  initialApprovedBy   User?        @relation("FieldVisitInitialApproval", fields: [initialApprovedById], references: [id])
  finalApprovedAt     DateTime?
  finalApprovedById   String?
  finalApprovedBy     User?        @relation("FieldVisitFinalApproval", fields: [finalApprovedById], references: [id])
  createdAt           DateTime     @default(now())
}

model Quote {
  id                  String      @id @default(cuid())
  // "QT-2026-0001" — same sequential-code pattern as every other
  // human-facing document number in this schema.
  quoteNumber         String      @unique
  // Required — a quote can only exist as the next step of a real
  // opportunity, never created standalone (see createQuote). customerId
  // below is derived from opportunity.customer at creation time, which is
  // itself why an opportunity has to have been promoted to a real
  // Customer (see promoteProspectToCustomer) before a quote can be built
  // for it — a prospect alone has nowhere for the quote's own customerId
  // to point.
  opportunityId       String
  opportunity         Opportunity @relation(fields: [opportunityId], references: [id])
  customerId          String
  customer            Customer    @relation(fields: [customerId], references: [id])
  projectId           String?
  project             Project?    @relation(fields: [projectId], references: [id])
  siteId              String
  site                Site        @relation(fields: [siteId], references: [id])
  status              String      @default("DRAFT") // DRAFT, SENT, ACCEPTED, DECLINED, EXPIRED
  validUntil          DateTime?
  // Snapshotted from the chosen site's own plant currency at creation time
  // — same reasoning as Invoice.currency (a later currency change must
  // never rewrite an already-issued document's own numbers).
  currency            String
  subtotal            Float
  taxRatePct          Float       @default(0)
  taxLabel            String      @default("VAT")
  taxAmount           Float       @default(0)
  total               Float
  notes               String?
  preparedById        String
  preparedBy          User        @relation("QuotePreparedBy", fields: [preparedById], references: [id])
  // Two-stage sign-off — same shape and skip rule as Opportunity's, but a
  // different role pair: initial from the Sales Manager, final from the
  // Plants Manager (see APPROVAL_CONFIG in sales/actions.ts). Required
  // before markQuoteSent will let a quote actually go out to the customer
  // — a price offer never reaches a customer without final sign-off on
  // file, same reasoning as Reservation approval gating production release.
  initialApprovedAt   DateTime?
  initialApprovedById String?
  initialApprovedBy   User?       @relation("QuoteInitialApproval", fields: [initialApprovedById], references: [id])
  finalApprovedAt     DateTime?
  finalApprovedById   String?
  finalApprovedBy     User?       @relation("QuoteFinalApproval", fields: [finalApprovedById], references: [id])
  sentAt              DateTime?
  respondedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  lines QuoteLine[]
}

model QuoteLine {
  id                String    @id @default(cuid())
  quoteId           String
  quote             Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  mixId             String
  mix               MixDesign @relation(fields: [mixId], references: [id])
  // What the customer is expected to order, not a hard commitment — the
  // actual delivered volume is whatever the resulting Reservation's own
  // batch tickets end up totaling once converted.
  estimatedVolumeM3 Float
  // Suggested from PriceListEntry (customer+mix flat rate, already used by
  // Billing) when one exists at creation time, freely editable after —
  // reuses the existing "umbrella pricing" data instead of a parallel table.
  unitPrice         Float
  lineTotal         Float

  reservation Reservation?
}

// ---------------------------------------------------------------------------
// Purchasing — dynamic purchase orders against Suppliers, plus contracts.
// MaterialReceipt keeps its existing free-text poNumber (ad-hoc buys still
// work with no PO on file) and gains an optional purchaseOrderLineId so a
// receipt CAN post against a real order line when one exists — the
// existing Stock Ledger (derived from MaterialReceipt/BatchComponentActual,
// see stock-ledger/page.tsx) then reflects it automatically, with no new
// inventory-balance table needed.
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id           String    @id @default(cuid())
  poNumber     String    @unique // PO-YYYY-NNNN, withSequentialNumber
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id])
  status       String    @default("DRAFT") // DRAFT, SENT, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  currency     String
  subtotal     Float
  taxRatePct   Float     @default(0)
  taxAmount    Float     @default(0)
  total        Float
  // Required before markPurchaseOrderSent will let this move past DRAFT
  // only when total is at/above the issuing plant's own
  // poApprovalThreshold (see that field's comment on Plant) — same
  // "status stays DRAFT, a separate gate field controls what can happen
  // next" shape as Quote.finalApprovedAt gating markQuoteSent. Null for
  // every PO under its plant's threshold, same as before this existed.
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  notes        String?
  createdById  String
  createdBy    User      @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines PurchaseOrderLine[]
  bills SupplierBill[]
}

// A line is EITHER a raw-material line (materialId + orderedMassKg/
// receivedMassKg, the original shape) OR a spare-part line (sparePartId +
// orderedQty/receivedQty, added for the Maintenance-to-Procurement
// pipeline) — never both. Enforced in action code (createPurchaseOrder),
// not a DB constraint, matching how this codebase already validates
// required-ness elsewhere (e.g. Quote.opportunityId).
model PurchaseOrderLine {
  id                String                 @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId        String?
  material          Material?              @relation(fields: [materialId], references: [id])
  orderedMassKg     Float?
  // Incremented as MaterialReceipt rows post against this line (see
  // receiveAgainstPurchaseOrder in purchasing/actions.ts) — what
  // PurchaseOrder.status's PARTIALLY_RECEIVED/RECEIVED derives from, and
  // what the PO detail screen shows as "still open."
  receivedMassKg    Float?                 @default(0)
  sparePartId       String?
  sparePart         SparePart?             @relation(fields: [sparePartId], references: [id])
  orderedQty        Float?
  receivedQty       Float?                 @default(0)
  // Back-relation to whichever SparePartsRequisition this line fulfills
  // (the FK — purchaseOrderLineId — lives on SparePartsRequisition itself)
  // — routes the requisition's status to ORDERED once the PO is created
  // (see createPurchaseOrder).
  sourceRequisition SparePartsRequisition?
  // Same back-relation, for the raw-material equivalent (see
  // MaterialRequisition below and completeBatch in production/actions.ts).
  sourceMaterialRequisition MaterialRequisition?
  unitPrice         Float
  lineTotal         Float

  receipts          MaterialReceipt[]
  sparePartReceipts SparePartReceipt[]
}

// A standing price/term agreement with a supplier — informational (feeds
// the PO creation screen's price suggestion the same way PriceListEntry
// feeds Sales quotes) rather than an enforced constraint, since a real
// buy sometimes has to happen off-contract.
model SupplierContract {
  id             String    @id @default(cuid())
  contractNumber String    @unique // SC-YYYY-NNNN
  supplierId     String
  supplier       Supplier  @relation(fields: [supplierId], references: [id])
  materialId     String?
  material       Material? @relation(fields: [materialId], references: [id])
  startDate      DateTime
  endDate        DateTime?
  pricePerUnit   Float?
  paymentTerms   String?
  status         String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Maintenance — preventive scheduling plus fault/repair tickets for the
// equipment fleet (trucks, pumps, silos, hoppers, support vehicles, bulkers,
// water tankers, loaders). No FK to any one equipment table — a ticket can
// be against any of them — equipmentType + equipmentId matches the relevant
// table by convention, the same plain-string-no-FK shape as User.role (see
// that field's comment). equipmentLabel snapshots the unit's own code/name
// at creation time so history still reads even if the unit is later
// renamed or removed. Complements, and eventually supersedes, the simpler
// Truck.lastMaintenanceAt/Pump.lastMaintenanceAt trip-count flag in
// src/lib/maintenance.ts — that flag stays as the dashboard's zero-setup
// early-warning signal; a flagged unit gets a real MaintenanceTicket here.
// ---------------------------------------------------------------------------

model MaintenancePlan {
  id              String    @id @default(cuid())
  equipmentType   String
  equipmentId     String
  equipmentLabel  String
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id])
  intervalDays    Int?
  intervalTrips   Int?
  lastCompletedAt DateTime?
  nextDueAt       DateTime?
  active          Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tickets MaintenanceTicket[]
}

model MaintenanceTicket {
  id               String           @id @default(cuid())
  ticketNumber     String           @unique // MT-YYYY-NNNN
  planId           String?
  plan             MaintenancePlan? @relation(fields: [planId], references: [id])
  equipmentType    String
  equipmentId      String
  equipmentLabel   String
  siteId           String
  site             Site             @relation(fields: [siteId], references: [id])
  type             String // PREVENTIVE, CORRECTIVE, INSPECTION
  priority         String           @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  status           String           @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  faultDescription String?
  reportedById     String?
  reportedBy       User?            @relation("MaintenanceReportedBy", fields: [reportedById], references: [id])
  assignedToId     String?
  assignedTo       User?            @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])
  scheduledFor     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  resolutionNotes  String?
  laborCost        Float?
  partsCost        Float?
  downtimeHours    Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  order MaintenanceOrder?
}

// A ticket ("the request") converts into an order when the fault needs real
// work — parts issued, technicians logged — rather than being closeable on
// the spot via MaintenanceTicket's own completeMaintenanceTicket/
// cancelMaintenanceTicket. One ticket, at most one order (ticketId unique).
model MaintenanceOrder {
  id              String            @id @default(cuid())
  orderNumber     String            @unique // MO-YYYY-NNNN
  ticketId        String            @unique
  ticket          MaintenanceTicket @relation(fields: [ticketId], references: [id])
  status          String            @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt       DateTime?
  completedAt     DateTime?
  resolutionNotes String?
  // Computed automatically at completion time from each technician's
  // hoursWorked × their own payroll wage (see computeLaborCost in
  // src/lib/maintenance.ts and completeMaintenanceOrder) — not a manual
  // entry. Nullable because a technician-less order (parts only) has
  // nothing to compute.
  laborCost       Float?
  createdById     String
  createdBy       User              @relation(fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  technicians  MaintenanceOrderTechnician[]
  parts        MaintenanceOrderPart[]
  requisitions SparePartsRequisition[]
}

// Real HR roster, not a User account or a separate crew-roster table like
// PumpCrewMember — maintenance technicians are staff, so this is the first
// place in the app linking maintenance work directly to Employee.
model MaintenanceOrderTechnician {
  id          String           @id @default(cuid())
  orderId     String
  order       MaintenanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  hoursWorked Float?
  createdAt   DateTime         @default(now())

  @@unique([orderId, employeeId])
}

// A serial number logged per issuance (not a pre-registered serialized-unit
// inventory — see the SparePart model comment) is what the traceability
// requirement actually asked for, so this stays free text rather than a
// full asset-lifecycle subsystem.
model MaintenanceOrderPart {
  id           String           @id @default(cuid())
  orderId      String
  order        MaintenanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sparePartId  String
  sparePart    SparePart        @relation(fields: [sparePartId], references: [id])
  quantity     Float
  unitCost     Float
  lineTotal    Float
  serialNumber String?
  issuedById   String
  issuedBy     User             @relation(fields: [issuedById], references: [id])
  issuedAt     DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Spare Parts warehouse — the Maintenance module's own inventory, distinct
// from Material (bulk raw concrete ingredients only). Stock balance is
// always derived (sum of SparePartReceipt.quantity minus sum of
// MaintenanceOrderPart.quantity, scoped by sparePartId+site) rather than
// stored, same convention the existing Stock Ledger report already uses for
// Material — no running-balance column to keep consistent under concurrent
// writes.
// ---------------------------------------------------------------------------

model SparePart {
  id                String    @id @default(cuid())
  code              String    @unique
  name              String
  category          String // MECHANICAL, ELECTRICAL, HYDRAULIC, CONSUMABLE, OTHER
  unitOfMeasure     String // PIECE, SET, LITER, KG, METER
  reorderThreshold  Float?
  defaultSupplierId String?
  defaultSupplier   Supplier? @relation(fields: [defaultSupplierId], references: [id])
  lastUnitCost      Float?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  receipts           SparePartReceipt[]
  orderParts         MaintenanceOrderPart[]
  requisitions       SparePartsRequisition[]
  purchaseOrderLines PurchaseOrderLine[]
}

model SparePartReceipt {
  id                  String             @id @default(cuid())
  receiptNumber       String             @unique // GRN-YYYY-NNNN
  sparePartId         String
  sparePart           SparePart          @relation(fields: [sparePartId], references: [id])
  siteId              String
  site                Site               @relation(fields: [siteId], references: [id])
  quantity            Float
  unitCost            Float
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  // Set when this receipt posts against a spare-part PurchaseOrderLine —
  // same shape as MaterialReceipt.purchaseOrderLineId (not unique, so a
  // line can be received across several partial deliveries), mirrors
  // postReceiptToPurchaseOrderLine's increment-received-qty pattern.
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  serialNumbers       String?
  receivedById        String
  receivedBy          User               @relation(fields: [receivedById], references: [id])
  receivedAt          DateTime           @default(now())
}

// The "auto-generate a purchase request for what's missing" piece — created
// automatically by issueSparePartToOrder when stock falls short, approved
// here, then routed into Purchasing's existing PurchaseOrder pipeline via
// purchaseOrderLineId once a PO line is built for it.
model SparePartsRequisition {
  id                  String             @id @default(cuid())
  requisitionNumber   String             @unique // SPR-YYYY-NNNN
  sparePartId         String
  sparePart           SparePart          @relation(fields: [sparePartId], references: [id])
  siteId              String
  site                Site               @relation(fields: [siteId], references: [id])
  quantityNeeded      Float
  maintenanceOrderId  String?
  maintenanceOrder    MaintenanceOrder?  @relation(fields: [maintenanceOrderId], references: [id])
  status              String             @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, ORDERED, FULFILLED, CANCELLED
  requestedById       String
  requestedBy         User               @relation("SPRRequestedBy", fields: [requestedById], references: [id])
  approvedById        String?
  approvedBy          User?              @relation("SPRApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  purchaseOrderLineId String?            @unique
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// The raw-material counterpart to SparePartsRequisition above — same
// PENDING_APPROVAL → APPROVED → ORDERED → FULFILLED lifecycle and the same
// approve/reject/bundle-into-PO actions (see warehouses/actions.ts and
// createPurchaseOrderFromMaterialRequisitions in purchasing/actions.ts),
// but auto-created by completeBatch (production/actions.ts) the moment a
// silo/hopper/chemical tank's level crosses at/below its own
// minThresholdPct, rather than by a human hitting a stock shortfall while
// issuing a part. requestedById is nullable for exactly that reason —
// there's no technician to attribute it to; a null value renders as
// "auto-generated" in the UI, same as logAudit's own SYSTEM actor
// fallback. Never more than one open (PENDING_APPROVAL/APPROVED/ORDERED)
// requisition per materialId+siteId at a time — completeBatch checks for
// one before creating another, so a run of many low batches doesn't flood
// Purchasing with duplicates for the same shortage.
model MaterialRequisition {
  id                  String             @id @default(cuid())
  requisitionNumber   String             @unique // MTR-YYYY-NNNN
  materialId          String
  material            Material           @relation(fields: [materialId], references: [id])
  siteId              String
  site                Site               @relation(fields: [siteId], references: [id])
  quantityNeededKg    Float
  status              String             @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, ORDERED, FULFILLED, CANCELLED
  requestedById       String?
  requestedBy         User?              @relation("MTRRequestedBy", fields: [requestedById], references: [id])
  approvedById        String?
  approvedBy          User?              @relation("MTRApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  purchaseOrderLineId String?            @unique
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// Finished Goods warehouse — side products (e.g. precast blocks), never the
// ready-mix concrete itself (which is delivered same-day, never warehoused).
// Deliberately small: a catalog plus a manual IN/OUT movement log, same
// derived-balance shape as Spare Parts above — no link to how "production"
// of these actually happens and no sales/shipment workflow.
// ---------------------------------------------------------------------------

model FinishedProduct {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  unitOfMeasure String
  unitPrice     Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements FinishedProductMovement[]
}

model FinishedProductMovement {
  id           String          @id @default(cuid())
  productId    String
  product      FinishedProduct @relation(fields: [productId], references: [id])
  siteId       String
  site         Site            @relation(fields: [siteId], references: [id])
  direction    String // IN (produced), OUT (shipped/sold/consumed)
  quantity     Float
  notes        String?
  recordedById String
  recordedBy   User            @relation(fields: [recordedById], references: [id])
  occurredAt   DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Finance — accounts payable (supplier bills/payments) and a lightweight
// cash-transaction ledger for movements Billing's AR side doesn't cover
// (payroll, utilities, fuel, misc income/expense), plus manual bank
// reconciliation (a reconciled flag on every money-movement row, matched by
// hand against a statement — see finance/actions.ts for why a real bank-feed
// import is out of scope). Deliberately NOT a double-entry general ledger /
// chart-of-accounts system — this plant has no such system today, and
// building one honestly is a much larger, separate effort; this covers what
// it actually needs: knowing what's owed, what's been paid, and what cash
// moved when, reconciled against the bank by hand.
// ---------------------------------------------------------------------------

model SupplierBill {
  id              String         @id @default(cuid())
  billNumber      String         @unique // BILL-YYYY-NNNN
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  siteId          String
  site            Site           @relation(fields: [siteId], references: [id])
  status          String         @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, CANCELLED
  billDate        DateTime       @default(now())
  dueDate         DateTime
  subtotal        Float
  taxAmount       Float          @default(0)
  total           Float
  currency        String
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments SupplierPayment[]
}

model SupplierPayment {
  id             String       @id @default(cuid())
  supplierBillId String
  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  amount         Float
  paidAt         DateTime     @default(now())
  method         String? // CASH, BANK_TRANSFER, CHEQUE
  reference      String?
  reconciled     Boolean      @default(false)
  reconciledAt   DateTime?
  createdAt      DateTime     @default(now())
}

model CashTransaction {
  id           String    @id @default(cuid())
  txnNumber    String    @unique // TXN-YYYY-NNNN
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id])
  direction    String // IN, OUT
  category     String // OPERATING_EXPENSE, PAYROLL, UTILITIES, FUEL, MAINTENANCE, OTHER_INCOME, OWNER_CONTRIBUTION, OTHER
  amount       Float
  currency     String
  occurredAt   DateTime  @default(now())
  description  String
  reference    String?
  reconciled   Boolean   @default(false)
  reconciledAt DateTime?
  createdById  String
  createdBy    User      @relation("CashTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Fleet — pump crew roster & driver incentives (from the RhinoMaster review)
// ---------------------------------------------------------------------------

// A reusable roster, distinct from the free-text pumpOperatorName/
// pumpAssistantName already on Trip — picking a name here instead of typing
// one prevents typos and lets an operator's history be tracked across many
// pump jobs over time.
model PumpCrewMember {
  id        String   @id @default(cuid())
  plantId   String
  plant     Plant    @relation(fields: [plantId], references: [id])
  name      String
  role      String // OPERATOR, HELPER
  phone     String?
  // Same per-person identifier as Employee.code — lets a company-wide
  // report (see getWorkerProductivityReport) recognize the same crew
  // member across more than one site-specific registration, since a
  // PumpCrewMember row (like Employee) belongs to exactly one plant.
  code      String?  @unique
  // ACTIVE, FROZEN, REMOVED — same three-state convention as
  // Employee.status (INACTIVE is kept as a legacy synonym of FROZEN on
  // existing rows rather than migrated, since it's just a display label).
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operatorTrips              Trip[]           @relation("PumpOperatorCrew")
  assistantTrips             Trip[]           @relation("PumpAssistantCrew")
  defaultForPumpsAsOperator  Pump[]           @relation("PumpDefaultOperator")
  defaultForPumpsAsAssistant Pump[]           @relation("PumpDefaultAssistant")
  operatorAssignments        PumpAssignment[] @relation("PumpAssignmentOperator")
  assistantAssignments       PumpAssignment[] @relation("PumpAssignmentAssistant")
  user                       User?
}

// A tiered per-trip bonus, one policy per plant — trips 1..freeTripsThreshold
// earn nothing, each trip up to tier2Threshold earns tier2RateSar, each up
// to tier3Threshold earns tier3RateSar, and every trip beyond that earns
// beyondRateSar. Payout itself is never stored — it's computed live from
// closed Trip counts per driver (src/lib/incentives.ts), the same
// derive-from-what-already-exists approach as the anomaly/strength/demand
// features above. Rates are in the plant's own currency, not a separate one.
// One policy per (plant, role) — generalized from a single driver-only
// policy per plant so pump crew and material-delivery drivers can each
// have their own tier ladder, not just mixer drivers. Model name kept as
// DriverIncentivePolicy (not renamed to something role-neutral) purely to
// avoid Prisma treating a model rename as drop-and-recreate against a
// live database with real rows — role below is what actually generalizes
// it. role is a plain string rather than every role in the system, since
// only roles with a real trip-count source (see src/lib/incentives.ts and
// the Incentives page) ever get a policy: MIXER_DRIVER, PUMP_OPERATOR,
// PUMP_ASSISTANT, BULKER_DRIVER, WATER_TANKER_DRIVER.
model DriverIncentivePolicy {
  id                 String   @id @default(cuid())
  // Which factory (Site — see the UI-terminology note on that model) this
  // policy applies to. Deliberately Plant-level, not a specific Station:
  // a driver can load from more than one station at the same plant (or
  // even a different plant) in one day, so the rate/threshold that
  // applies is whichever plant a given trip actually happened at, not a
  // station the driver happens to be nominally assigned to.
  siteId             String
  site               Site     @relation(fields: [siteId], references: [id])
  role               String   @default("MIXER_DRIVER")
  freeTripsThreshold Int      @default(10)
  tier2Threshold     Int      @default(15)
  // Field names carry "Sar" from the reviewed system's own SAR-denominated
  // policy — the actual amount is always rendered in the owning plant's
  // own currency (Plant.currency), never a second stored currency.
  tier2RateSar       Float    @default(0)
  tier3Threshold     Int      @default(20)
  tier3RateSar       Float    @default(0)
  beyondRateSar      Float    @default(20)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([siteId, role])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  role        String
  module      String
  recordId    String
  field       String?
  beforeValue String?
  afterValue  String?
  reasonCode  String?
  createdAt   DateTime @default(now())
}

// The account-role roster itself — User.role stays a plain, unenforced
// String (same as every other status/role field in this schema; see the
// UI-terminology note on Site for the project's general "no FK where a
// plain matching string already works" stance), so a Role row existing
// here is what makes a `key` valid to assign, not a foreign key
// constraint. RolePermission.role/ActionPermission.role already store
// arbitrary role strings with no FK either — this table just gives those
// strings a name, an Arabic/English label, and a place an Admin can add a
// new one from (see /roles) without a code change. The 5 original roles
// are seeded with isSystem true so /roles can refuse to delete or rename
// the ones requireRole/MODULE_ROLES defaults still reference by name in
// code.
model Role {
  id        String   @id @default(cuid())
  key       String   @unique
  labelAr   String
  labelEn   String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Database-editable override of the compiled-in MODULE_ROLES map
// (src/lib/permissions.ts) — lets an Admin grant/revoke a role's access to
// a module from the Permissions screen instead of it only ever being a
// code change. A module with zero rows here still works: canAccessModule
// falls back to its MODULE_ROLES default, so this table starts empty and
// only ever holds the modules an Admin has actually touched. Deliberately
// role-only (no plantId) — permissions are which screens a role can reach
// at all, not a per-plant concern, same scope MODULE_ROLES already had.
model RolePermission {
  id        String   @id @default(cuid())
  moduleKey String
  role      String
  createdAt DateTime @default(now())

  @@unique([moduleKey, role])
}

// Finer-grained sibling of RolePermission — gates one specific action
// within a module (e.g. "approve a reservation" vs. just "view
// reservations") rather than the whole screen. Same fallback shape: the
// compiled default for each actionKey lives in ACTION_ROLES
// (src/lib/permissions.ts); a module/action pair with zero rows here
// falls back to that default until an Admin actually customizes it.
model ActionPermission {
  id        String   @id @default(cuid())
  moduleKey String
  actionKey String
  role      String
  createdAt DateTime @default(now())

  @@unique([moduleKey, actionKey, role])
}

// Volume-based incentive policy — despite the name (kept from when this
// only covered pump operators, and left as-is to avoid Prisma treating a
// rename as drop-and-recreate against a live database), this now backs
// ANY role whose incentive method is VOLUME_M3 (see IncentiveMethod
// below), not just PUMP_OPERATOR. Priced per m³ by a rate bracket:
// PUMP_OPERATOR/PUMP_ASSISTANT get real reach-tiered brackets (a
// longer-reach pump job prices differently than a short one, from the
// same Trip/Pump); every other volume-based role just gets a single
// "flat" bracket (minReachM 0, maxReachM null) since reach doesn't apply
// to them — calculateVolumeIncentivePayout in src/lib/incentives.ts
// matches that catch-all bracket even when a trip has no reachM at all.
// One policy per (plant, role); its rate table is PumpReachRateBracket.
model PumpIncentivePolicy {
  id           String   @id @default(cuid())
  // Plant-level, not Station-level — same reasoning as
  // DriverIncentivePolicy.siteId above: a pump crew can work more than
  // one station (even more than one plant) in a day.
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id])
  role         String   @default("PUMP_OPERATOR")
  // "تارجت الشركة" — company target: m³ (or, for BULKER/WATER_TANKER
  // roles, tons) delivered up to this amount in the period earns
  // nothing; only the amount beyond it is priced, and only at the rate
  // bracket matching whichever pump actually carried it (pump roles) or
  // the plant's single flat rate (every other role).
  freeVolumeM3 Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rateBrackets PumpReachRateBracket[]

  @@unique([siteId, role])
}

model PumpReachRateBracket {
  id           String              @id @default(cuid())
  policyId     String
  policy       PumpIncentivePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  minReachM    Float
  // null = open-ended top bracket ("60m and up").
  maxReachM    Float?
  ratePerM3Sar Float
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// Which of the two incentive calculations applies to a (plant, role) pair
// — TRIP_COUNT (tiered per-trip bonus, DriverIncentivePolicy) or VOLUME_M3
// (per-m³ commission above a target, PumpIncentivePolicy). Same
// fallback-to-compiled-default shape as RolePermission/ActionPermission in
// src/lib/permissions.ts: a role with zero rows here uses the compiled
// DEFAULT_INCENTIVE_METHOD map (src/lib/incentives.ts) until an Admin
// picks explicitly from the Incentives module's "plan" tab.
model IncentiveMethod {
  id        String   @id @default(cuid())
  // Plant-level, not Station-level — same reasoning as
  // DriverIncentivePolicy.siteId above.
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  role      String
  method    String // TRIP_COUNT, VOLUME_M3
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, role])
}

// Cement bulkers, water tankers, and loaders share one model (rather than
// three near-identical ones like Truck/Pump) since none of them carry the
// type-specific spec fields those two do (drum capacity, pump reach) — just
// registration details and a default driver. `type` is what the Equipment
// screen's tabs filter on.
model SupportVehicle {
  id              String    @id @default(cuid())
  plantId         String
  plant           Plant     @relation(fields: [plantId], references: [id])
  type            String // BULKER, WATER_TANKER, LOADER
  code            String
  year            Int?
  chassisNumber   String?
  plateNumber     String?
  // Regulatory compliance dates — same shape as Truck/Pump's own.
  licenseValidFrom        DateTime?
  periodicInspectionDueAt DateTime?
  operatingCardExpiry     DateTime?
  // Same real-deadline shape as operatingCardExpiry above — flagged by the
  // Equipment screen's own expiryFlag the same way once it approaches/
  // passes, not just informational like licenseValidFrom.
  insurancePolicyExpiry   DateTime?
  defaultDriverId String?
  defaultDriver   Employee? @relation(fields: [defaultDriverId], references: [id])
  status          String    @default("ACTIVE") // ACTIVE, IDLE, MAINTENANCE, OUT_OF_SERVICE
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// A revocable, scoped credential for a machine-to-machine caller (a GPS
// telematics provider, a SCADA edge gateway) — replaces relying on one
// shared INTEGRATION_API_KEY env var for every integration forever. Only
// the SHA-256 hash is stored (src/lib/apiKeys.ts), never the raw key —
// it's shown to the Admin exactly once at creation time and can't be
// recovered afterward, only revoked and replaced with a new one. scope
// limits what a compromised or over-shared key can actually do (a GPS
// provider's key has no business posting silo readings). The legacy env
// var still works as an ALL-scope fallback for compatibility —
// verifyIntegrationRequest in src/lib/integration-auth.ts checks both.
model ApiKey {
  id          String    @id @default(cuid())
  label       String
  keyHash     String    @unique
  // First few characters of the raw key, kept in the clear so the Admin
  // can recognize which key is which in the list without the full secret.
  keyPrefix   String
  scope       String    @default("ALL") // ALL, TELEMATICS, SCADA
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

// The general notification engine — a single persistent per-user inbox
// any part of the app can write to via notify()/notifyRoles() (see
// src/lib/notify.ts), read by the bell in the sidebar (see
// NotificationBell). Deliberately in-app only for this first version — no
// email/SMS/push delivery channel exists yet, same "detection is
// automatic, the delivery method is the simplest one that actually works
// today" scoping already used for the WhatsApp pour reminder and the CAPA
// auto-open this session; a real external delivery channel is a separate
// later decision once this inbox itself has proven useful. No live push
// either — the bell's list is fetched at page load/navigation like every
// other "due" panel already in this app (reservation reminders, material
// requisitions), not over a socket.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  // Where clicking the notification should take the user — an
  // app-relative path, same shape as every internal Link href elsewhere.
  link      String?
  // Which part of the app raised this (e.g. "Quality", "Purchasing") —
  // for grouping/an icon in the bell, same free-text convention
  // logAudit's own `module` field already uses.
  module    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// A browser's Web Push subscription — one row per device a user has
// enabled notifications on (a phone and a desktop both work, independently).
// endpoint/p256dh/auth are exactly the three fields the Push API's own
// PushSubscription.toJSON() returns; nothing here is invented. See
// src/lib/push.ts for how these get used, and notify()'s own extension in
// src/lib/notify.ts for why this piggybacks on the existing in-app
// notification entry point rather than being a separate call every action
// has to remember to make. A subscription the push service reports as
// gone (expired, uninstalled, permission revoked) gets deleted the moment
// a send to it fails with 404/410 — never left around silently failing.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// General ledger — an ADDITIVE double-entry layer that runs alongside the
// existing Invoice/Payment/CreditNote/SupplierBill/SupplierPayment/
// CashTransaction models, never replacing them. Every real financial event
// those models already record also auto-posts a balanced JournalEntry
// here (see postJournalEntry in src/lib/ledger.ts) — nothing about the
// existing Billing/Finance/Payroll screens or their data changes; a
// Trial Balance report reads from this ledger only. A small fixed chart
// of accounts (self-seeded on first use, not user-editable in this first
// version — that's a real accounting-system feature, out of scope here).
// ---------------------------------------------------------------------------

model Account {
  id   String @id @default(cuid())
  // Plain external convention (1000s assets, 2000s liabilities, 3000s
  // equity, 4000s revenue, 5000s expense) — informational only, not
  // enforced against `type`.
  code String @unique
  name String
  type String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE

  journalLines JournalLine[]
}

// One balanced posting per real financial event — sum(debit) must equal
// sum(credit) across its lines, checked in code at post time
// (postJournalEntry) since Postgres itself can't express that constraint
// across rows. Scoped to one site + currency, never blended, same "never
// mix currencies" rule every other money-grouping in this app already
// follows — a plant's own Trial Balance is filtered by both, same as
// every other financial report.
model JournalEntry {
  id          String   @id @default(cuid())
  entryNumber String   @unique // JE-YYYY-NNNN
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  currency    String
  // Which real event caused this posting, and its id — the same "why does
  // this number exist" traceability logAudit already gives every other
  // write in this app, e.g. sourceModule "Billing", sourceRecordId the
  // Invoice's own id.
  sourceModule   String
  sourceRecordId String
  memo        String?
  postedAt    DateTime @default(now())

  lines JournalLine[]

  @@index([siteId, postedAt])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Float        @default(0)
  credit         Float        @default(0)
  // Denormalized copies of the parent JournalEntry's own siteId/currency,
  // set once at creation (postJournalEntry) and never changed — Prisma's
  // groupBy can only group/filter by a model's own scalar columns, not a
  // related model's, so without these the Trial Balance would have to
  // fetch every line ever posted into the app just to sum them in JS. With
  // them, it can ask Postgres to do the summing directly (see LedgerTab in
  // finance/page.tsx), which stays fast regardless of how many years of
  // journal entries have piled up.
  siteId   String
  currency String

  @@index([siteId, currency, accountId])
}

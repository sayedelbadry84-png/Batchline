// Batchline data model — Phase 1 (Foundation)
// Dev datasource is SQLite for zero-setup local running; swap provider to
// "postgresql" and DATABASE_URL to a Postgres connection string for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Role is a plain string (SQLite has no native enum support); valid values
// are enforced in application code: ADMIN, PLANT_OPERATOR, QUALITY_SUPERVISOR,
// ACCOUNTANT, DRIVER, CUSTOMER.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String
  plantId      String?
  plant        Plant?   @relation(fields: [plantId], references: [id])
  // Links a DRIVER-role account to their Employee record, so the driver app
  // resolves "my trips" from the logged-in session instead of a picker.
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditEvents  AuditEvent[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Plant {
  id        String   @id @default(cuid())
  name      String
  city      String
  currency  String   @default("EGP")
  timezone  String   @default("Africa/Cairo")
  // Batching tolerance & alert configuration (Module 12 — Plant Management).
  drumTimerLimitMinutes     Int   @default(90)
  returnAbsorptionThresholdM3 Float @default(0.2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  silos      Silo[]
  hoppers    Hopper[]
  employees  Employee[]
  projects   Project[]
  trucks     Truck[]
  batchTickets BatchTicket[]
  pumps      Pump[]
  materialReceipts MaterialReceipt[]
}

model Silo {
  id               String   @id @default(cuid())
  plantId          String
  plant            Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name             String
  materialType     String
  capacityTons     Float
  currentLevelTons Float    @default(0)
  minThresholdPct  Float    @default(15)
  lastCalibration  DateTime?
  // Populated by the SCADA sensor-reading webhook (see /api/scada/silo-reading)
  // to distinguish a sensor-fed level from a manual dashboard override.
  lastSensorReadingAt DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  receipts MaterialReceipt[]
}

model Hopper {
  id               String   @id @default(cuid())
  plantId          String
  plant            Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name             String
  aggregateType    String
  capacityTons     Float
  currentLevelTons Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  receipts MaterialReceipt[]
}

model MixDesign {
  id             String   @id @default(cuid())
  code           String   @unique
  grade          String
  exposureClass  String?
  slumpTargetMm  Float
  wcRatio        Float
  yieldTargetM3  Float    @default(1)
  status         String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, RETIRED
  standardCost   Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  components   MixComponent[]
  reservations Reservation[]
  batchTickets BatchTicket[]
  certificates ComplianceCertificate[]
}

model Material {
  id               String   @id @default(cuid())
  name             String
  type             String   // CEMENT, FLY_ASH, SAND, COARSE_AGGREGATE, ADMIXTURE, WATER
  specificGravity  Float?
  absorptionPct    Float?
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mixComponents    MixComponent[]
  batchActuals     BatchComponentActual[]
  receipts         MaterialReceipt[]
}

model MixComponent {
  id                 String    @id @default(cuid())
  mixId              String
  mix                MixDesign @relation(fields: [mixId], references: [id], onDelete: Cascade)
  materialId         String
  material           Material  @relation(fields: [materialId], references: [id])
  designMassKgPerM3  Float
  tolerancePct       Float     @default(2)

  @@unique([mixId, materialId])
}

model Customer {
  id            String   @id @default(cuid())
  legalName     String
  taxId         String?
  creditLimit   Float    @default(0)
  paymentTerms  String   @default("Net 30")
  contactEmail  String?
  contactPhone  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
}

model Supplier {
  id               String   @id @default(cuid())
  name             String
  materialCatalog  String?
  leadTimeDays     Int?
  rejectionRatePct Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  materials Material[]
  materialReceipts MaterialReceipt[]
}

model Project {
  id                  String   @id @default(cuid())
  name                String
  customerId          String
  customer            Customer @relation(fields: [customerId], references: [id])
  plantId             String
  plant               Plant    @relation(fields: [plantId], references: [id])
  siteAddress         String
  contractedVolumeM3  Float?
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reservations Reservation[]
}

model Reservation {
  id                 String    @id @default(cuid())
  projectId          String
  project            Project   @relation(fields: [projectId], references: [id])
  mixId              String
  mix                MixDesign @relation(fields: [mixId], references: [id])
  requestedVolumeM3  Float
  pourWindowStart    DateTime
  status             String    @default("REQUESTED") // REQUESTED, CONFIRMED, IN_PRODUCTION, DELIVERED, CANCELLED
  // Pour-order details captured at intake — distinct from the mix design's
  // own slump target, since site conditions can call for an adjustment on
  // the day (e.g. a pump mix run wetter than the design slump).
  slumpRequestedMm   Float?
  temperatureC       Float?
  siteLocation       String?
  siteContactName    String?
  siteContactPhone   String?
  deliveryMethod     String?   @default("CHUTE") // PUMP, CHUTE
  structuralElement  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  batchTickets BatchTicket[]
  pumpAssignment PumpAssignment?
}

model Employee {
  id             String    @id @default(cuid())
  plantId        String
  plant          Plant     @relation(fields: [plantId], references: [id])
  name           String
  role           String
  licenseNumber  String?
  licenseExpiry  DateTime?
  shiftPattern   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  trips Trip[]
  sampledTestBatches TestBatch[]
  user User?
}

// ---------------------------------------------------------------------------
// Material Receiving
// ---------------------------------------------------------------------------

model MaterialReceipt {
  id                 String    @id @default(cuid())
  plantId            String
  plant              Plant     @relation(fields: [plantId], references: [id])
  supplierId         String
  supplier           Supplier  @relation(fields: [supplierId], references: [id])
  materialId         String
  material           Material  @relation(fields: [materialId], references: [id])
  poNumber           String?
  orderedMassKg      Float?
  grossWeightKg      Float
  tareWeightKg       Float
  netWeightKg        Float
  moisturePct        Float?
  qcStatus           String    @default("PENDING") // PENDING, PASSED, HELD, REJECTED
  postedToInventory  Boolean   @default(false)
  destinationSiloId  String?
  destinationSilo    Silo?     @relation(fields: [destinationSiloId], references: [id])
  destinationHopperId String?
  destinationHopper  Hopper?   @relation(fields: [destinationHopperId], references: [id])
  receivedAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 2 — Production & Fleet
// ---------------------------------------------------------------------------

model Truck {
  id                 String   @id @default(cuid())
  plantId            String
  plant              Plant    @relation(fields: [plantId], references: [id])
  code               String
  drumCapacityM3     Float
  maxAgitationRpm    Float?
  gpsDeviceId        String?
  status             String   @default("ACTIVE") // ACTIVE, MAINTENANCE, OUT_OF_SERVICE
  // Populated by the GPS telematics webhook (see /api/telematics/ping).
  lastLat            Float?
  lastLng            Float?
  lastPingAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trips Trip[]
}

// A batch ticket is released against a confirmed reservation. Component
// targets are snapshotted from the mix design at release time (scaled to
// the requested volume) so a later mix-design edit never silently changes
// a ticket that has already been batched.
model BatchTicket {
  id                String    @id @default(cuid())
  reservationId     String
  reservation       Reservation @relation(fields: [reservationId], references: [id])
  mixId             String
  mix               MixDesign @relation(fields: [mixId], references: [id])
  plantId           String
  plant             Plant     @relation(fields: [plantId], references: [id])
  ticketNumber      String    @unique
  volumeM3          Float
  status            String    @default("RELEASED") // RELEASED, BATCHING, COMPLETE, CANCELLED
  releasedAt        DateTime  @default(now())
  batchCompletedAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  components BatchComponentActual[]
  trip       Trip?
}

model BatchComponentActual {
  id              String      @id @default(cuid())
  batchTicketId   String
  batchTicket     BatchTicket @relation(fields: [batchTicketId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material    @relation(fields: [materialId], references: [id])
  targetMassKg    Float
  actualMassKg    Float?
  moisturePct     Float?

  @@unique([batchTicketId, materialId])
}

model Trip {
  id                String       @id @default(cuid())
  batchTicketId     String       @unique
  batchTicket       BatchTicket  @relation(fields: [batchTicketId], references: [id])
  truckId           String
  truck             Truck        @relation(fields: [truckId], references: [id])
  driverId          String
  driver            Employee     @relation(fields: [driverId], references: [id])
  status            String       @default("LOADING") // LOADING, IN_TRANSIT, ON_SITE, DISCHARGING, CLOSED
  batchTime         DateTime     @default(now())
  departTime        DateTime?
  arriveTime        DateTime?
  dischargeStart    DateTime?
  dischargeEnd      DateTime?
  volumeDeliveredM3 Float?
  // Driver-app delivery confirmation. The photo is stored as a data URL for
  // this phase (no object storage wired up yet) — fine for demo volumes,
  // swap for a real blob store (S3-compatible) before production traffic.
  deliveryPhotoDataUrl String?
  deliverySignedBy     String?
  deliverySignedAt     DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  drumReturn DrumReturn?
  testBatches TestBatch[]
}

model DrumReturn {
  id                 String   @id @default(cuid())
  tripId             String   @unique
  trip               Trip     @relation(fields: [tripId], references: [id])
  returnedVolumeM3   Float
  minutesSinceBatch  Int
  disposition        String   // NO_CHARGE, REDISPATCHED, PARTIAL_CREDIT, FULL_WASTE
  note               String?
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Phase 3 — Quality & Compliance
// ---------------------------------------------------------------------------

model TestBatch {
  id                String    @id @default(cuid())
  tripId            String
  trip              Trip      @relation(fields: [tripId], references: [id])
  sampleType        String    @default("CYLINDER") // CYLINDER, CUBE, SLUMP_ONLY
  sampleTime        DateTime  @default(now())
  slumpMeasuredMm   Float?
  airContentPct     Float?
  concreteTempC     Float?
  sampledById       String?
  sampledBy         Employee? @relation(fields: [sampledById], references: [id])
  createdAt         DateTime  @default(now())

  labResults LabResult[]
}

model LabResult {
  id                 String    @id @default(cuid())
  testBatchId        String
  testBatch          TestBatch @relation(fields: [testBatchId], references: [id], onDelete: Cascade)
  ageDays            Int
  breakStrengthMpa   Float
  targetStrengthMpa  Float
  passFail           String    // PASS, FAIL
  testedOn           DateTime  @default(now())
  createdAt          DateTime  @default(now())
}

model ComplianceCertificate {
  id            String    @id @default(cuid())
  mixId         String
  mix           MixDesign @relation(fields: [mixId], references: [id])
  standardRef   String
  issuedDate    DateTime
  expiryDate    DateTime
  issuingBody   String
  documentUrl   String?
  createdAt     DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Phase 4 — Pumps
// ---------------------------------------------------------------------------

model Pump {
  id           String   @id @default(cuid())
  plantId      String
  plant        Plant    @relation(fields: [plantId], references: [id])
  code         String
  pumpType     String   // BOOM, LINE, STATIONARY
  reachM       Float?
  hourlyRate   Float
  standbyRate  Float?
  status       String   @default("ACTIVE") // ACTIVE, MAINTENANCE, OUT_OF_SERVICE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments PumpAssignment[]
}

model PumpAssignment {
  id              String      @id @default(cuid())
  pumpId          String
  pump            Pump        @relation(fields: [pumpId], references: [id])
  reservationId   String      @unique
  reservation     Reservation @relation(fields: [reservationId], references: [id])
  scheduledStart  DateTime
  billedHours     Float?
  status          String      @default("SCHEDULED") // SCHEDULED, ON_SITE, COMPLETE, CANCELLED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  role       String
  module     String
  recordId   String
  field      String?
  beforeValue String?
  afterValue  String?
  reasonCode  String?
  createdAt   DateTime @default(now())
}
